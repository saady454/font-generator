---
import Layout from '../../layouts/Layout.astro';
import { BLOG_POSTS, type BlogPost } from '../../data/blog-posts';
import { SITE_CONFIG } from '../../config/site';

export function getStaticPaths() {
  return Object.keys(BLOG_POSTS).map((postKey) => ({
    params: { slug: postKey },
    props: { post: BLOG_POSTS[postKey] },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const articleSchema: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.metaDescription,
  "datePublished": post.publishedDate,
  "dateModified": post.publishedDate,
  "author": {
    "@type": "Organization",
    "name": SITE_CONFIG.brandName,
    "url": SITE_CONFIG.baseUrl,
  },
  "publisher": {
    "@type": "Organization",
    "name": SITE_CONFIG.name,
    "logo": {
      "@type": "ImageObject",
      "url": SITE_CONFIG.logoUrl,
    },
  },
  "inLanguage": "de-DE",
};

if (post.featuredImage) {
  articleSchema["image"] = `${SITE_CONFIG.baseUrl.replace(/\/$/, '')}${post.featuredImage.src}`;
}

const schemasToRender: Record<string, any>[] = [articleSchema];

if (post.faqs && post.faqs.length > 0) {
  schemasToRender.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": post.faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer,
      },
    })),
  });
}
---

<Layout
  title={`${post.metaTitle} | Schriftarten.io Magazin`}
  description={post.metaDescription}
  canonicalUrl={`/blog/${post.slug}`}
  schema={schemasToRender}
>
  <main class="py-12 md:py-16 bg-[#0a0a08]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-stone-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Startseite</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white transition-colors">Magazin</a>
        <span>/</span>
        <span class="text-stone-300 font-semibold truncate max-w-xs">{post.title}</span>
      </nav>

      <!-- Article Header -->
      <header class="mb-8 pb-8 border-b border-white/10">
        <div class="flex items-center gap-3 text-xs text-stone-400 mb-4">
          <span class="px-2.5 py-1 rounded-full bg-amber-500/15 text-amber-400 font-bold text-[11px]">
            {post.category}
          </span>
          <span>•</span>
          <span>{post.publishedDate}</span>
          <span>•</span>
          <span>{post.readTime}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
          {post.h1}
        </h1>

        <p class="text-base sm:text-lg text-stone-300 leading-relaxed font-medium bg-amber-500/5 border-l-4 border-amber-500 p-5 rounded-r-2xl">
          {post.intro}
        </p>

        <!-- Featured Image -->
        {post.featuredImage && (
          <figure class="mt-8 rounded-3xl overflow-hidden border border-white/10 bg-[#141412] shadow-2xl">
            <img
              src={post.featuredImage.src}
              alt={post.featuredImage.alt}
              class="w-full h-auto object-cover max-h-[460px]"
              loading="eager"
            />
            {post.featuredImage.caption && (
              <figcaption class="p-3 text-xs text-stone-400 text-center italic bg-white/5 border-t border-white/5">
                {post.featuredImage.caption}
              </figcaption>
            )}
          </figure>
        )}
      </header>

      <!-- Article Body -->
      <article class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-10 space-y-12 text-stone-300 text-sm sm:text-base leading-relaxed">
        {post.sections.map((sec) => (
          <section class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight flex items-center gap-2">
              <span class="text-amber-400">#</span>
              <span>{sec.heading}</span>
            </h2>

            {sec.image && (
              <figure class="my-6 rounded-2xl overflow-hidden border border-white/10 bg-[#0d0f17] shadow-xl">
                <img
                  src={sec.image.src}
                  alt={sec.image.alt}
                  class="w-full h-auto object-cover max-h-[420px]"
                  loading="lazy"
                />
                {sec.image.caption && (
                  <figcaption class="p-3 text-xs text-stone-400 text-center italic bg-white/5 border-t border-white/5">
                    {sec.image.caption}
                  </figcaption>
                )}
              </figure>
            )}

            {sec.content.map((paragraph) => (
              <p class="text-stone-300 leading-relaxed" set:html={paragraph} />
            ))}

            <!-- Subsections (H3) -->
            {sec.subsections && sec.subsections.length > 0 && (
              <div class="mt-6 space-y-6 pl-2 sm:pl-4 border-l-2 border-amber-500/20">
                {sec.subsections.map((sub) => (
                  <div class="space-y-2">
                    <h3 class="text-base sm:text-lg font-bold text-amber-300">
                      {sub.subheading}
                    </h3>
                    {sub.content.map((p) => (
                      <p class="text-stone-300 leading-relaxed text-sm sm:text-base" set:html={p} />
                    ))}
                  </div>
                ))}
              </div>
            )}

            <!-- Comparison Table -->
            {sec.table && (
              <div class="my-6 overflow-x-auto rounded-2xl border border-white/10 bg-[#0d0f17] shadow-lg">
                <table class="w-full text-left text-xs sm:text-sm text-stone-300">
                  <thead class="bg-amber-500/10 text-amber-300 text-xs uppercase font-bold tracking-wider border-b border-white/10">
                    <tr>
                      {sec.table.headers.map((h) => (
                        <th class="py-3 px-4 sm:px-6">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-white/5">
                    {sec.table.rows.map((row, idx) => (
                      <tr class={idx % 2 === 0 ? "bg-white/[0.02]" : "bg-transparent hover:bg-white/[0.04] transition-colors"}>
                        {row.map((cell, cIdx) => (
                          <td class={`py-3.5 px-4 sm:px-6 ${cIdx === 0 ? "font-semibold text-white" : ""}`}>
                            {cell}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        ))}

        <!-- FAQs Section -->
        {post.faqs && post.faqs.length > 0 && (
          <section class="pt-8 border-t border-white/10 space-y-6">
            <div class="flex items-center gap-2">
              <span class="text-xl">❓</span>
              <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
                Häufige Fragen zu Schriftarten (FAQ)
              </h2>
            </div>

            <div class="space-y-4">
              {post.faqs.map((faq) => (
                <details class="group bg-[#0d0f17] border border-white/10 rounded-2xl p-4 sm:p-5 transition-all open:border-amber-500/40">
                  <summary class="font-bold text-white group-open:text-amber-400 cursor-pointer list-none flex items-center justify-between gap-4 text-sm sm:text-base">
                    <span>{faq.question}</span>
                    <span class="text-amber-400 font-bold transition-transform group-open:rotate-180">↓</span>
                  </summary>
                  <p class="mt-3 text-stone-300 text-sm leading-relaxed border-t border-white/5 pt-3">
                    {faq.answer}
                  </p>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- Cross-Links into Silos (AGENTS.md Section 5) -->
        <div class="pt-8 mt-12 border-t border-white/10">
          <h3 class="text-sm font-bold uppercase tracking-wider text-amber-400 mb-4 flex items-center gap-2">
            <span>🔗</span> Passende Werkzeuge & Plattform-Guides
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {post.relatedSilos.map((silo) => (
              <a
                href={silo.href}
                class="p-3.5 rounded-2xl bg-white/5 border border-white/5 hover:border-amber-500/40 hover:bg-amber-500/10 text-xs font-bold text-white hover:text-amber-300 transition-all flex items-center justify-between group"
              >
                <span>{silo.label}</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            ))}
          </div>
        </div>
      </article>
    </div>
  </main>
</Layout>
