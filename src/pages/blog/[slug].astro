---
import Layout from '../../layouts/Layout.astro';
import { BLOG_POSTS, type BlogPost } from '../../data/blog-posts';
import { SITE_CONFIG } from '../../config/site';

export function getStaticPaths() {
  return Object.keys(BLOG_POSTS).map((postKey) => ({
    params: { slug: postKey },
    props: { post: BLOG_POSTS[postKey] },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.metaDescription,
  "datePublished": post.publishedDate,
  "dateModified": post.publishedDate,
  "author": {
    "@type": "Organization",
    "name": SITE_CONFIG.brandName,
    "url": SITE_CONFIG.baseUrl,
  },
  "publisher": {
    "@type": "Organization",
    "name": SITE_CONFIG.name,
    "logo": {
      "@type": "ImageObject",
      "url": SITE_CONFIG.logoUrl,
    },
  },
  "inLanguage": "de-DE",
};
---

<Layout
  title={`${post.metaTitle} | Schriftarten.io Magazin`}
  description={post.metaDescription}
  canonicalUrl={`/blog/${post.slug}`}
  schema={articleSchema}
>
  <main class="py-12 md:py-16 bg-[#0a0a08]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-stone-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Startseite</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white transition-colors">Magazin</a>
        <span>/</span>
        <span class="text-stone-300 font-semibold truncate max-w-xs">{post.title}</span>
      </nav>

      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b border-white/10">
        <div class="flex items-center gap-3 text-xs text-stone-400 mb-4">
          <span class="px-2.5 py-1 rounded-full bg-amber-500/15 text-amber-400 font-bold text-[11px]">
            {post.category}
          </span>
          <span>•</span>
          <span>{post.publishedDate}</span>
          <span>•</span>
          <span>{post.readTime}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
          {post.h1}
        </h1>

        <p class="text-base sm:text-lg text-stone-300 leading-relaxed font-medium bg-amber-500/5 border-l-4 border-amber-500 p-5 rounded-r-2xl">
          {post.intro}
        </p>
      </header>

      <!-- Article Body -->
      <article class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-10 space-y-10 text-stone-300 text-sm sm:text-base leading-relaxed">
        {post.sections.map((sec) => (
          <section class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              {sec.heading}
            </h2>
            {sec.content.map((paragraph) => (
              <p class="text-stone-300 leading-relaxed">
                {paragraph}
              </p>
            ))}
          </section>
        ))}

        <!-- Cross-Links into Silos (AGENTS.md Section 5) -->
        <div class="pt-8 mt-12 border-t border-white/10">
          <h3 class="text-sm font-bold uppercase tracking-wider text-amber-400 mb-4 flex items-center gap-2">
            <span>🔗</span> Passende Werkzeuge & Plattform-Guides
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {post.relatedSilos.map((silo) => (
              <a
                href={silo.href}
                class="p-3.5 rounded-2xl bg-white/5 border border-white/5 hover:border-amber-500/40 hover:bg-amber-500/10 text-xs font-bold text-white hover:text-amber-300 transition-all flex items-center justify-between group"
              >
                <span>{silo.label}</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            ))}
          </div>
        </div>
      </article>
    </div>
  </main>
</Layout>
