---
import Layout from '../../layouts/Layout.astro';
import TextStyleConverter from '../../components/TextStyleConverter.astro';
import FontStyleGrid from '../../components/FontStyleGrid.astro';
import { FONT_STYLES_DETAIL, type FontStyleDetail } from '../../data/font-details';
import { NAVIGATION_DATA } from '../../data/navigation';

export function getStaticPaths() {
  return Object.keys(FONT_STYLES_DETAIL).map((styleKey) => ({
    params: { style: styleKey },
    props: { font: FONT_STYLES_DETAIL[styleKey] },
  }));
}

interface Props {
  font: FontStyleDetail;
}

const { font } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": font.faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a,
    },
  })),
};

const themeClass = `font-theme-${font.slug}`;

const FONT_ICONS: Record<string, string> = {
  'fette-schrift': '🔥',
  'kursive-schrift': '🌸',
  'gotische-schrift': '⚔️',
  'bubble-schrift': '🫧',
  'kleine-schrift': '💎',
  'graffiti-schrift': '🎨',
  'glitch-schrift': '⚡',
  'durchgestrichen': '🚫',
  'tattoo-schrift': '🗡️',
  'handschrift': '✍️',
  'unterschrift': '✒️',
  'dekorative-schrift': '꧁',
  'eckige-schrift': '【】',
  'wellige-schrift': '〰️',
};

const fontIcon = FONT_ICONS[font.slug] || '✨';
---

<Layout
  title={font.metaTitle}
  description={font.metaDescription}
  canonicalUrl={`/schrift/${font.slug}`}
  schema={faqSchema}
>
  <main class={`py-12 md:py-16 relative overflow-hidden ${themeClass}`}>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-stone-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Startseite</a>
        <span>/</span>
        <a href="/schrift" class="hover:text-white transition-colors">Schriftarten</a>
        <span>/</span>
        <span class="text-stone-300 font-semibold">{font.name}</span>
      </nav>

      <!-- Hero Title -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <div class="font-hero-badge inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-extrabold uppercase tracking-wider mb-3 shadow-md">
          <span class="text-sm">{fontIcon}</span>
          <span>{font.badge}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight">
          {font.h1.includes('—') ? (
            <>
              {font.h1.split('—')[0]} &mdash; <span class="font-h1-accent">{font.h1.split('—')[1]}</span>
            </>
          ) : font.h1.includes('–') ? (
            <>
              {font.h1.split('–')[0]} &ndash; <span class="font-h1-accent">{font.h1.split('–')[1]}</span>
            </>
          ) : font.h1.includes(':') ? (
            <>
              {font.h1.split(':')[0]}: <span class="font-h1-accent">{font.h1.split(':')[1]}</span>
            </>
          ) : (
            <span class="font-h1-accent">{font.h1}</span>
          )}
        </h1>
        <p class="mt-4 text-base text-stone-300 leading-relaxed max-w-2xl mx-auto">
          {font.tagline}
        </p>
      </div>

      <!-- Interactive Converter Component (Dedicated multi-variant suite for this style) -->
      <TextStyleConverter
        defaultText={font.previewText}
        pageSlug={font.slug}
        maxChars={200}
        showPresets={true}
      />

      <!-- Content Grid: Background, Use Cases & Cross-Linking to Platforms -->
      <div class="mt-16 grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Column: Editorial Sections or Standard Use Cases -->
        <div class="lg:col-span-2 space-y-8">
          
          {font.editorialSections && font.editorialSections.length > 0 ? (
            <!-- Rich Editorial Article Structure -->
            <div class="space-y-8">
              {font.editorialSections.map((sec) => (
                <section class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-5">
                  <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight flex items-center gap-2">
                    <span class="text-amber-400">#</span>
                    <span>{sec.heading}</span>
                  </h2>

                  {sec.image && (
                    <figure class="my-4 rounded-2xl overflow-hidden border border-white/10 bg-[#0d0f17] shadow-xl">
                      <img
                        src={sec.image.src}
                        alt={sec.image.alt}
                        class="w-full h-auto object-cover max-h-[400px]"
                        loading="lazy"
                      />
                      {sec.image.caption && (
                        <figcaption class="p-2.5 text-xs text-stone-400 text-center italic bg-white/5 border-t border-white/5">
                          {sec.image.caption}
                        </figcaption>
                      )}
                    </figure>
                  )}

                  {sec.content.map((p) => (
                    <p class="text-sm sm:text-base text-stone-300 leading-relaxed" set:html={p} />
                  ))}

                  <!-- Subsections (H3) -->
                  {sec.subsections && sec.subsections.length > 0 && (
                    <div class="mt-5 space-y-5 pl-3 border-l-2 border-amber-500/30">
                      {sec.subsections.map((sub) => (
                        <div class="space-y-2">
                          <h3 class="text-base sm:text-lg font-bold text-amber-300">
                            {sub.subheading}
                          </h3>
                          {sub.content.map((subP) => (
                            <p class="text-xs sm:text-sm text-stone-300 leading-relaxed" set:html={subP} />
                          ))}
                        </div>
                      ))}
                    </div>
                  )}

                  <!-- Comparison Table -->
                  {sec.table && (
                    <div class="my-4 overflow-x-auto rounded-2xl border border-white/10 bg-[#0d0f17] shadow-lg">
                      <table class="w-full text-left text-xs sm:text-sm text-stone-300">
                        <thead class="bg-amber-500/10 text-amber-300 text-xs uppercase font-bold tracking-wider border-b border-white/10">
                          <tr>
                            {sec.table.headers.map((h) => (
                              <th class="py-3 px-4">{h}</th>
                            ))}
                          </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                          {sec.table.rows.map((row, idx) => (
                            <tr class={idx % 2 === 0 ? "bg-white/[0.02]" : "bg-transparent"}>
                              {row.map((cell, cIdx) => (
                                <td class={`py-3 px-4 ${cIdx === 0 ? "font-semibold text-white" : ""}`}>
                                  {cell}
                                </td>
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}
                </section>
              ))}
            </div>
          ) : (
            <!-- Standard Fallback Sections -->
            <div class="space-y-8">
              <!-- 1. Dedicated Use Cases Section -->
              <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8">
                <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                  <span>🎯</span> Wofür eignet sich diese Schrift?
                </h2>
                <ul class="space-y-3 text-sm text-stone-300">
                  {font.useCases.map((useCase) => (
                    <li class="flex items-start gap-3">
                      <span class="w-5 h-5 rounded-md bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                        ✓
                      </span>
                      <span class="leading-relaxed">{useCase}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- 2. Background & Unicode Typografie -->
              <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8">
                <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                  <span>📖</span> Hintergrund &amp; Unicode-Typografie
                </h2>
                <p class="text-sm text-stone-300 leading-relaxed mb-4">
                  {font.historyText}
                </p>
                <p class="text-xs sm:text-sm text-stone-400 leading-relaxed">
                  Im Gegensatz zu herkömmlichen Schriftdateien (.ttf/.otf) können diese Zeichen ohne jegliche Software-Installation direkt kopiert und in Eingabefeldern von Apps und Browsern verwendet werden.
                </p>
              </div>
            </div>
          )}

          <!-- FAQ Accordion for this Style -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8">
            <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
              <span>❓</span> Häufige Fragen zu {font.name}
            </h2>
            <div class="space-y-4">
              {font.faqs.map((faq) => (
                <div class="border-b border-white/5 pb-4 last:border-b-0 last:pb-0">
                  <h3 class="text-sm sm:text-base font-bold text-white mb-1.5">{faq.q}</h3>
                  <p class="text-xs sm:text-sm text-stone-300 leading-relaxed">{faq.a}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar: Full List of 7 Platforms & Reusable FontStyleGrid for other 13 styles -->
        <div class="space-y-6">
          <!-- 1. Empfohlene Plattformen (All 7 platforms) -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6">
            <h3 class="text-sm font-bold uppercase tracking-wider text-amber-400 mb-4 flex items-center gap-1.5">
              <span>📱</span> Empfohlene Plattformen
            </h3>
            <p class="text-xs text-stone-400 mb-4">
              Hier kommt {font.name} besonders gut zur Geltung:
            </p>
            <div class="space-y-3">
              {font.recommendedPlatforms.map((plat) => (
                <a
                  href={plat.slug}
                  class="block p-3 rounded-2xl bg-white/5 border border-white/5 hover:border-amber-500/40 hover:bg-amber-500/10 transition-all group"
                >
                  <div class="text-xs font-bold text-white group-hover:text-amber-400 flex items-center justify-between">
                    <span class="flex items-center gap-1.5">
                      <span>{plat.icon}</span>
                      <span>{plat.name}</span>
                    </span>
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </div>
                  <div class="text-[11px] text-stone-400 mt-1 leading-snug">{plat.reason}</div>
                </a>
              ))}
            </div>
          </div>

          <!-- 2. Weitere Schriftstile (Reusable FontStyleGrid component) -->
          <FontStyleGrid
            title="Weitere Schriftstile"
            titleIcon=""
            currentSlug={font.slug}
          />
        </div>
      </div>
    </div>
  </main>
</Layout>
