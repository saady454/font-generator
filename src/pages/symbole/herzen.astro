---
import Layout from '../../layouts/Layout.astro';
import GradientMeshBackground from '../../components/GradientMeshBackground.astro';
import FontStyleGrid from '../../components/FontStyleGrid.astro';
import { HERZEN_CATEGORIES, HERZEN_SYMBOLS_DATA } from '../../data/expanded-symbols-data';
import { NAVIGATION_DATA } from '../../data/navigation';

const totalCount = HERZEN_SYMBOLS_DATA.length;

const heartFaqs = [
  {
    q: 'Wie kann ich ein Herzsymbol kopieren?',
    a: 'Wähle ein Herz aus der Liste aus, klicke darauf oder kopiere es mit Strg + C und füge es anschließend mit Strg + V ein. Auf dem Smartphone kannst du das Zeichen länger gedrückt halten.',
  },
  {
    q: 'Welches Herz eignet sich für Instagram?',
    a: 'Für Bios und Namen sind einfache Zeichen wie ♡, ♥ oder ❥ praktisch. Dekorative Kombinationen können ebenfalls funktionieren, sofern Instagram das jeweilige Zeichen unterstützt.',
  },
  {
    q: 'Warum wird ein Herz manchmal als Quadrat angezeigt?',
    a: 'Ein Quadrat kann erscheinen, wenn die verwendete Schrift oder das jeweilige System das Zeichen nicht darstellen kann. In diesem Fall kann ein einfacheres Herz wie ♡, ♥ oder ❤ als Alternative sinnvoll sein.',
  },
  {
    q: 'Kann ich Herzsymbole überall verwenden?',
    a: 'Nicht jedes Zeichen wird von jeder Plattform unterstützt. Bei Profilnamen, Benutzernamen oder Spielen gelten außerdem die jeweiligen Zeichenregeln der Plattform.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": heartFaqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a,
    },
  })),
};

const heartTableData = [
  { char: '♡', name: 'Leeres Herz', suitableFor: 'dezente Bios & ästhetische Profile' },
  { char: '♥', name: 'Schwarzes Herz', suitableFor: 'klassischer Look & Social Media' },
  { char: '❤', name: 'Schweres schwarzes Herz', suitableFor: 'starke Akzente & Überschriften' },
  { char: '❥', name: 'Gedrehtes Herz', suitableFor: 'dynamische Nicknames & Status' },
  { char: '❦', name: 'Florales Herz', suitableFor: 'Vintage, Deko & Steckbriefe' },
  { char: '❣', name: 'Herz-Ausrufezeichen', suitableFor: 'Hervorhebungen & Emotionen' },
  { char: '💕', name: 'Zwei Herzen', suitableFor: 'Freundschaft & Zuneigung' },
  { char: '💖', name: 'Funkelndes Herz', suitableFor: 'besondere Momente & Sparkle' },
  { char: '💗', name: 'Wachsendes Herz', suitableFor: 'Liebe & Freude im Chat' },
  { char: '💘', name: 'Herz mit Pfeil', suitableFor: 'Verliebtheit & Amor' },
  { char: '💓', name: 'Schlagendes Herz', suitableFor: 'Aufregung & Leidenschaft' },
  { char: '💔', name: 'Gebrochenes Herz', suitableFor: 'Liebeskummer & Melancholie' },
];

const coloredHearts = [
  { emoji: '❤️', color: 'Rot', desc: 'Liebe & Leidenschaft' },
  { emoji: '🧡', color: 'Orange', desc: 'Freundschaft & Wärme' },
  { emoji: '💛', color: 'Gelb', desc: 'Freude & Optimismus' },
  { emoji: '💚', color: 'Grün', desc: 'Natur & Harmonie' },
  { emoji: '💙', color: 'Blau', desc: 'Treue & Vertrauen' },
  { emoji: '💜', color: 'Lila', desc: 'Magie & Eleganz' },
  { emoji: '🖤', color: 'Schwarz', desc: 'Dark Aesthetic' },
  { emoji: '🤍', color: 'Weiß', desc: 'Reinheit & Frieden' },
  { emoji: '🤎', color: 'Braun', desc: 'Geborgenheit' },
];
---

<Layout
  title="Herzen Symbole zum Kopieren ♥ ♡ ❤ – Herzzeichen & Emojis"
  description="Herzen Symbole zum Kopieren: ♥ ♡ ❤ 💕 und viele weitere Herzzeichen und Herz-Emojis. Einfach auswählen, kopieren und direkt einfügen."
  canonicalUrl="/symbole/herzen/"
  schema={faqSchema}
>
  <main class="relative bg-[#0F1220] min-h-screen py-12 md:py-16 overflow-hidden homepage-mesh-wrapper text-white">
    <!-- Romantic Hearts Themed Gradient Mesh Layer -->
    <GradientMeshBackground variant="herzen" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs sm:text-sm text-stone-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/symbole" class="hover:text-amber-400 transition-colors">Symbole</a>
        <span>/</span>
        <span class="text-stone-200">Herzen Symbole</span>
      </nav>

      <!-- Page Header & H1 -->
      <div class="text-center max-w-4xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-pink-500/10 border border-pink-500/30 text-pink-400 text-xs font-semibold uppercase tracking-wider mb-4">
          <span>♥</span> 1-Klick Kopieren &bull; {totalCount} Herzzeichen &bull; Unicode &bull; Emojis
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight mb-4">
          Herzen Symbole zum Kopieren ♥ ♡ ❤
        </h1>
        <p class="text-base sm:text-lg text-stone-300 max-w-2xl mx-auto">
          Schöne Herzsymbole und Herz-Emojis direkt kopieren und für Instagram, WhatsApp, TikTok, Discord und Texte verwenden.
        </p>
      </div>

      <!-- Filterable Interactive Heart Symbols Library -->
      <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl mb-16">
        <!-- Section Header with Dynamic Counter -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-white/5">
          <div>
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>♥</span> Herz-Symbole &amp; Romantik Bibliothek
            </h2>
            <p class="text-xs text-stone-400 mt-1">
              Wähle eine Kategorie, um die Herzen zu filtern, oder klicke direkt auf ein Herz zum Kopieren:
            </p>
          </div>
          <span
            id="heart-count-display"
            class="px-3 py-1.5 rounded-full bg-pink-500/10 border border-pink-500/30 text-pink-400 text-xs font-semibold shrink-0 self-start sm:self-center"
          >
            {totalCount} Symbole verfügbar
          </span>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap gap-2 mb-8" id="heart-category-pills">
          {HERZEN_CATEGORIES.map((cat, idx) => (
            <button
              type="button"
              class={`btn-heart-cat px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 focus:outline-none ${
                idx === 0
                  ? 'bg-pink-500 text-white shadow-md shadow-pink-500/20'
                  : 'bg-[#0a0a08] text-stone-300 border border-white/10 hover:border-pink-500/40 hover:text-white'
              }`}
              data-category={cat.id}
            >
              <span>{cat.icon}</span>
              <span>{cat.name}</span>
            </button>
          ))}
        </div>

        <!-- Symbol Cards Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3.5" id="hearts-library-grid">
          {HERZEN_SYMBOLS_DATA.map((sym) => (
            <div
              class="heart-card p-4 rounded-2xl bg-[#0a0a08] border border-white/5 hover:border-pink-500/40 hover:-translate-y-0.5 transition-all flex flex-col items-center justify-between gap-3 group text-center cursor-pointer"
              data-char={sym.char}
              data-category={sym.category}
            >
              <!-- Symbol Display -->
              <span class="text-2xl sm:text-3xl text-white group-hover:scale-110 transition-transform select-all font-mono min-h-[36px] flex items-center justify-center">
                {sym.char}
              </span>

              <!-- German Label -->
              <span class="text-[11px] text-stone-400 group-hover:text-stone-200 font-medium truncate max-w-full px-1" title={sym.germanLabel}>
                {sym.germanLabel}
              </span>

              <!-- Kopieren Button -->
              <button
                type="button"
                class="btn-copy-heart w-full py-1.5 px-3 rounded-lg bg-white/5 hover:bg-pink-500 hover:text-white border border-white/10 hover:border-pink-500 text-xs font-semibold text-stone-300 transition-all flex items-center justify-center gap-1"
                aria-label={`Kopiere ${sym.germanLabel}`}
              >
                <span>Kopieren</span>
              </button>
            </div>
          ))}
        </div>
      </div>

      <!-- Content Grid: Left Column (Editorial Article) & Right Sidebar -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- LEFT COLUMN (lg:col-span-2): Editorial Article Content -->
        <div class="lg:col-span-2 space-y-8">

          <!-- IMAGE 1: Featured Hero Image -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl overflow-hidden shadow-2xl">
            <img
              src="/images/herzen-symbole-hero.svg"
              alt="Herzen Symbole zum Kopieren und Herz-Emojis"
              class="w-full h-auto aspect-video object-cover"
              loading="eager"
            />
            <p class="text-xs text-stone-400 p-3 text-center border-t border-white/5 bg-[#0a0a08]">
              Herzzeichen und Herz-Emojis für Copy &amp; Paste
            </p>
          </div>

          <!-- Section 1: Intro -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Manchmal soll ein Text nicht nur verständlich, sondern auch etwas persönlicher wirken. Ein Herzzeichen reicht oft schon aus. Wer <strong>Herzen Symbole zum Kopieren</strong> sucht, möchte deshalb meist nicht lange nach Sonderzeichen suchen, sondern ein passendes Herz direkt auswählen und einfügen.
            </p>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Gerade bei Instagram-Bios, WhatsApp-Nachrichten, TikTok-Profilen, Discord-Namen oder persönlichen Texten sind verschiedene Herzformen praktisch. Hier findest du klassische Herzzeichen, farbige Herz-Emojis und dekorative Varianten zum schnellen Kopieren. Entdecke auch unsere Hauptseite für <a href="/symbole" class="text-pink-400 hover:underline font-semibold">Symbole &amp; Emoji zum Kopieren</a>.
            </p>
          </div>

          <!-- Section 2: Herzsymbole direkt kopieren (Table of 12) -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              Herzsymbole direkt kopieren
            </h2>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Hier sind einige der beliebtesten Herzen auf einen Blick:
            </p>

            <!-- Table of 12 Heart Symbols -->
            <div class="overflow-x-auto my-4 border border-white/10 rounded-2xl">
              <table class="w-full text-left text-sm text-stone-300">
                <thead class="bg-white/5 text-xs uppercase text-stone-400">
                  <tr>
                    <th scope="col" class="px-4 py-3">Symbol</th>
                    <th scope="col" class="px-4 py-3">Herz</th>
                    <th scope="col" class="px-4 py-3">Geeignet für</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                  {heartTableData.map((item) => (
                    <tr class="hover:bg-white/5">
                      <td class="px-4 py-3 font-mono text-xl font-bold text-pink-400">{item.char}</td>
                      <td class="px-4 py-3 font-semibold text-white">{item.name}</td>
                      <td class="px-4 py-3 text-stone-300">{item.suitableFor}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Markiere einfach das gewünschte Zeichen und kopiere es mit <kbd class="px-2 py-0.5 bg-white/10 rounded text-xs font-mono text-pink-300">Strg + C</kbd>. Anschließend kannst du es mit <kbd class="px-2 py-0.5 bg-white/10 rounded text-xs font-mono text-pink-300">Strg + V</kbd> an der gewünschten Stelle einfügen. Auf dem Smartphone funktioniert das meist über langes Drücken und die Optionen zum Kopieren und Einfügen.
            </p>
          </div>

          <!-- IMAGE 2: Vergleichstabelle Visual -->
          <div class="rounded-2xl overflow-hidden border border-white/10">
            <img
              src="/images/herzen-symbole-vergleich-tabelle.svg"
              alt="Verschiedene Herzsymbole zum Kopieren"
              class="w-full h-auto aspect-video object-cover"
              loading="lazy"
            />
            <p class="text-xs text-stone-400 p-2.5 text-center bg-[#0a0a08] border-t border-white/5">
              Klassische Herzzeichen und beliebte Herz-Emojis auf einen Blick
            </p>
          </div>

          <!-- Section 3: Klassische Herzzeichen zum Kopieren -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              Klassische Herzzeichen zum Kopieren
            </h2>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Für einen schlichten Look eignen sich besonders ♡, ♥ und ❤. Sie wirken klar und lassen sich vielseitig einsetzen.
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="text-2xl block mb-1 font-mono text-white">♡</span>
                <span class="text-xs text-stone-300">leeres Herz</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="text-2xl block mb-1 font-mono text-pink-400">♥</span>
                <span class="text-xs text-stone-300">ausgefülltes Herz</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="text-2xl block mb-1 font-mono text-red-400">❤</span>
                <span class="text-xs text-stone-300">schweres schwarzes Herz</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="text-2xl block mb-1 font-mono text-purple-400">❥</span>
                <span class="text-xs text-stone-300">gedrehtes Herz</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="text-2xl block mb-1 font-mono text-pink-300">❦</span>
                <span class="text-xs text-stone-300">florales Herz</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="text-2xl block mb-1 font-mono text-pink-300">❧</span>
                <span class="text-xs text-stone-300">florales Zeichen</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center sm:col-span-2">
                <span class="text-2xl block mb-1 font-mono text-red-500">❣</span>
                <span class="text-xs text-stone-300">Herz-Ausrufezeichen</span>
              </div>
            </div>

            <p class="text-sm sm:text-base text-stone-300 leading-relaxed pt-2">
              Die Zeichen gehören zu unterschiedlichen Unicode-Zeichen und können deshalb in verschiedenen Anwendungen und Schriftarten etwas unterschiedlich dargestellt werden. Unicode führt beispielsweise ♡ als „WHITE HEART SUIT“, ♥ als „BLACK HEART SUIT“ und ❤ als „HEAVY BLACK HEART“.
            </p>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Für eine vollständige technische Übersicht bietet das <a href="https://www.unicode.org/emoji/charts/full-emoji-list.html" target="_blank" rel="noopener noreferrer" class="text-pink-400 hover:text-pink-300 underline font-semibold">Unicode Emoji-Verzeichnis</a> offizielle Informationen zu Emoji-Zeichen, Namen und Codepunkten.
            </p>
          </div>

          <!-- Section 4: Farbige Herz-Emojis -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              Farbige Herz-Emojis
            </h2>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Neben klassischen Herzzeichen gibt es viele farbige Emojis. Sie eignen sich besonders für Chats, Statusmeldungen und Social-Media-Texte:
            </p>

            <div class="grid grid-cols-3 sm:grid-cols-3 gap-2.5 pt-1">
              {coloredHearts.map((item) => (
                <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-2.5 flex items-center gap-2">
                  <span class="text-xl">{item.emoji}</span>
                  <div>
                    <span class="text-xs font-bold text-white block">{item.color}</span>
                    <span class="text-[10px] text-stone-400">{item.desc}</span>
                  </div>
                </div>
              ))}
            </div>

            <p class="text-sm sm:text-base text-stone-300 leading-relaxed pt-2">
              Dazu kommen besondere Varianten wie 💕, 💖, 💗, 💘, 💓, 💞, 💝 und 💔. Unicode führt diese Zeichen als eigene Emoji-Zeichen beziehungsweise Emoji-Sequenzen.
            </p>
            <p class="text-xs sm:text-sm text-stone-400 leading-relaxed">
              Die konkrete Darstellung kann je nach Gerät, Betriebssystem, App und verwendeter Schrift unterschiedlich aussehen. Deshalb kann dasselbe Emoji auf zwei Geräten leicht anders gestaltet sein.
            </p>
          </div>

          <!-- IMAGE 3: Farbige Emojis Visual -->
          <div class="rounded-2xl overflow-hidden border border-white/10">
            <img
              src="/images/herzen-symbole-farbige-emojis.svg"
              alt="Farbige Herz-Emojis in verschiedenen Farben"
              class="w-full h-auto aspect-video object-cover"
              loading="lazy"
            />
            <p class="text-xs text-stone-400 p-2.5 text-center bg-[#0a0a08] border-t border-white/5">
              Farbige Herzen für Chats und Social Media
            </p>
          </div>

          <!-- Section 5: Herzen Symbole zum Kopieren für Instagram und WhatsApp -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              Herzen Symbole zum Kopieren für Instagram und WhatsApp
            </h2>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Herzen eignen sich für viele kurze Texte. Besonders praktisch sind sie dort, wo ein einzelnes Zeichen mehr Ausdruck geben soll.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
              <div class="bg-[#1a1a16] border border-white/5 rounded-2xl p-4 space-y-2">
                <span class="text-xs font-bold text-pink-400 uppercase tracking-wider block">Für Instagram</span>
                <div class="text-xs text-stone-300 space-y-1 font-mono">
                  <p>♡ Lieblingsmomente</p>
                  <p>♥ Fotografie &amp; Reisen ♥</p>
                  <p>୨♡୧ My Profile ୨♡୧</p>
                  <p>✧♡✧</p>
                </div>
              </div>

              <div class="bg-[#1a1a16] border border-white/5 rounded-2xl p-4 space-y-2">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block">Für WhatsApp</span>
                <div class="text-xs text-stone-300 space-y-1 font-mono">
                  <p>Danke dir ❤️</p>
                  <p>Hab dich lieb 💕</p>
                  <p>Alles Liebe 🤍</p>
                  <p>Bis später ♥</p>
                  <p>Gute Nacht 🌙💗</p>
                </div>
              </div>

              <div class="bg-[#1a1a16] border border-white/5 rounded-2xl p-4 space-y-2">
                <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider block">TikTok &amp; Discord</span>
                <div class="text-xs text-stone-300 space-y-1 font-mono">
                  <p>♡ Creator</p>
                  <p>♥ Gaming ♥</p>
                  <p>୨♡୧ Name ୨♡୧</p>
                  <p>❥ Lieblingssong</p>
                </div>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-stone-400 leading-relaxed pt-2">
              Bei Benutzernamen und Profilnamen solltest du jedoch beachten, dass nicht jede Plattform jedes Sonderzeichen akzeptiert. Außerdem können ausgefallenere Zeichen auf manchen Geräten schlechter dargestellt werden.
            </p>
          </div>

          <!-- Section 6: Ästhetische Herz-Kombinationen -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              Ästhetische Herz-Kombinationen
            </h2>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Ein einzelnes Herz ist nicht die einzige Möglichkeit. Mehrere Zeichen lassen sich zu kleinen dekorativen Kombinationen verbinden:
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              <div class="bg-[#1a1a16] border border-white/5 rounded-2xl p-3.5 flex items-center justify-between group">
                <span class="font-mono text-sm font-bold text-white">♡₊˚ Dein Text ˚₊♡</span>
                <button class="btn-copy-inline px-2.5 py-1 bg-white/5 group-hover:bg-pink-500 group-hover:text-white rounded-lg text-xs font-semibold text-stone-300 transition-colors" data-copy="♡₊˚ Dein Text ˚₊♡">Kopieren</button>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-2xl p-3.5 flex items-center justify-between group">
                <span class="font-mono text-sm font-bold text-white">✧♡✧ Name ✧♡✧</span>
                <button class="btn-copy-inline px-2.5 py-1 bg-white/5 group-hover:bg-pink-500 group-hover:text-white rounded-lg text-xs font-semibold text-stone-300 transition-colors" data-copy="✧♡✧ Name ✧♡✧">Kopieren</button>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-2xl p-3.5 flex items-center justify-between group">
                <span class="font-mono text-sm font-bold text-white">୨♡୧ My Profile ୨♡୧</span>
                <button class="btn-copy-inline px-2.5 py-1 bg-white/5 group-hover:bg-pink-500 group-hover:text-white rounded-lg text-xs font-semibold text-stone-300 transition-colors" data-copy="୨♡୧ My Profile ୨♡୧">Kopieren</button>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-2xl p-3.5 flex items-center justify-between group">
