---
import Layout from '../../layouts/Layout.astro';
import GradientMeshBackground from '../../components/GradientMeshBackground.astro';
import { SYMBOLS_DATA } from '../../data/symbol-data';
import { SITE_CONFIG } from '../../config/site';

const symbolsList = Object.values(SYMBOLS_DATA);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Symbole & Emojis zum Kopieren – Sterne, Herzen, Rahmen & mehr',
  description: 'Kopiere tausende beliebte Unicode-Symbole, Emojis, Rahmen, Herzen und Kaomojis mit einem Klick.',
  url: `${SITE_CONFIG.baseUrl}/symbole`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: symbolsList.map((category, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: category.name,
      url: `${SITE_CONFIG.baseUrl}${category.slug}`,
    })),
  },
};
---

<Layout
  title="Symbole & Emojis zum Kopieren – Sterne, Herzen, Rahmen & mehr | Schriftarten.io"
  description="Große Sammlung an Unicode-Symbolen zum 1-Klick Kopieren: Sterne, Herzen, ästhetische Rahmen, Flügel und Kaomojis für Instagram, WhatsApp & Gaming."
  canonicalUrl="/symbole"
  schema={schema}
>
  <main class="relative bg-[#0F1220] min-h-screen py-12 md:py-16 overflow-hidden homepage-mesh-wrapper">
    <!-- Reusable Multi-Color Gradient Mesh Layer -->
    <GradientMeshBackground />

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-stone-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Startseite</a>
        <span>/</span>
        <span class="text-stone-300 font-semibold">Symbole</span>
      </nav>

      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider mb-4">
          <span>✨ Unicode Symbole & Emojis</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Symbole & Emojis zum Kopieren – Sterne, Herzen, Rahmen & mehr
        </h1>
        <p class="mt-4 text-base sm:text-lg text-stone-300 leading-relaxed">
          Kopiere tausende beliebte Unicode-Symbole, Emojis, Rahmen, Herzen und Kaomojis mit einem einzigen Klick. Perfekt zum Verzieren deiner Social-Media-Bios, Nicknames, Chat-Nachrichten und Profil-Texte.
        </p>
      </div>

      <!-- 4 Symbol Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {symbolsList.map((category) => (
          <a
            href={category.slug}
            class="group block p-8 rounded-3xl bg-[#141412] border border-white/10 hover:border-amber-500/40 shadow-xl hover:shadow-2xl hover:shadow-amber-500/10 transition-all duration-200 relative overflow-hidden"
          >
            <div class="flex items-start justify-between gap-3 mb-5">
              <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
                {category.icon}
              </div>
              <span class="text-xs font-bold px-3 py-1 rounded-full bg-white/5 border border-white/10 text-stone-300 group-hover:bg-amber-500/20 group-hover:text-amber-300 group-hover:border-amber-500/30 transition-colors">
                {category.symbols.length}+ Symbole
              </span>
            </div>

            <h2 class="text-2xl font-bold text-white group-hover:text-amber-400 transition-colors mb-2 flex items-center justify-between">
              <span>{category.name}</span>
              <span class="text-stone-500 group-hover:text-amber-400 group-hover:translate-x-1 transition-all">→</span>
            </h2>

            <p class="text-sm text-stone-400 leading-relaxed mb-6">
              {category.description}
            </p>

            <!-- Sample Symbols Live Pill Preview -->
            <div class="flex flex-wrap gap-2 pt-4 border-t border-white/5">
              {category.symbols.slice(0, 8).map((sym) => (
                <span class="px-2.5 py-1.5 rounded-xl bg-[#0a0a08] border border-white/5 text-sm font-mono text-stone-200 group-hover:border-amber-500/20 transition-colors">
                  {sym.char}
                </span>
              ))}
              <span class="px-2.5 py-1.5 rounded-xl bg-amber-500/10 text-xs font-bold text-amber-400">
                + mehr
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
