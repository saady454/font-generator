---
import Layout from '../../layouts/Layout.astro';
import GradientMeshBackground from '../../components/GradientMeshBackground.astro';
import { EMOTIKONS_CATEGORIES, EMOTIKONS_SYMBOLS_DATA } from '../../data/expanded-symbols-data';
import { NAVIGATION_DATA } from '../../data/navigation';

const totalCount = EMOTIKONS_SYMBOLS_DATA.length;
---

<Layout
  title="Emotikons & Kaomoji zum Kopieren – (◕‿◕) ¯\_(ツ)_/¯ Emojis"
  description={`Kopiere über ${totalCount} japanische Kaomojis, ASCII-Textgesichter, fröhliche, traurige und süße Emotikons mit 1 Klick für Discord, TikTok, Twitch & Social Media.`}
  canonicalUrl="/symbole/emotikons"
>
  <main class="relative bg-[#0F1220] min-h-screen py-12 md:py-16 overflow-hidden homepage-mesh-wrapper">
    <!-- Playful Kaomoji & Emotikons Themed Gradient Mesh Layer -->
    <GradientMeshBackground variant="emotikons" />

    <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-stone-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Startseite</a>
        <span>/</span>
        <a href="/symbole" class="hover:text-white transition-colors">Symbole</a>
        <span>/</span>
        <span class="text-stone-300 font-semibold">Emotikons & Kaomoji</span>
      </nav>

      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider mb-3">
          <span>◕‿◕ 1-Klick Kopieren</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Emotikons & Kaomoji zum Kopieren
        </h1>
        <p class="mt-4 text-base text-stone-300 leading-relaxed max-w-2xl mx-auto">
          Kopiere japanische Kaomojis, niedliche ASCII-Textgesichter, Shrugs und emotionale Text-Smileys mit nur einem Klick. Perfekt für Twitch-Chats, Discord-Nachrichten und Bios.
        </p>
      </div>

      <!-- Filterable Kaomoji Library -->
      <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-xl">
        <!-- Section Header with Dynamic Counter -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-white/5">
          <div>
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>◕‿◕</span> Kaomoji & Text-Smileys Bibliothek
            </h2>
            <p class="text-xs text-stone-400 mt-1">
              Wähle eine Stimmung, um die Kaomojis zu filtern, oder klicke direkt auf eine Karte zum Kopieren:
            </p>
          </div>
          <span
            id="kaomoji-count-display"
            class="px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold shrink-0 self-start sm:self-center"
          >
            {totalCount} Symbole verfügbar
          </span>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap gap-2 mb-8" id="kaomoji-category-pills">
          {EMOTIKONS_CATEGORIES.map((cat, idx) => (
            <button
              type="button"
              class={`btn-kaomoji-cat px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 focus:outline-none ${
                idx === 0
                  ? 'bg-amber-500 text-black shadow-md shadow-amber-500/20'
                  : 'bg-[#0a0a08] text-stone-300 border border-white/10 hover:border-amber-500/40 hover:text-white'
              }`}
              data-category={cat.id}
            >
              <span>{cat.icon}</span>
              <span>{cat.name}</span>
            </button>
          ))}
        </div>

        <!-- Kaomoji Cards Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3.5" id="kaomojis-library-grid">
          {EMOTIKONS_SYMBOLS_DATA.map((sym) => (
            <div
              class="kaomoji-card p-4 rounded-2xl bg-[#0a0a08] border border-white/5 hover:border-amber-500/40 hover:-translate-y-0.5 transition-all flex flex-col items-center justify-between gap-3 group text-center"
              data-char={sym.char}
              data-category={sym.category}
            >
              <!-- Symbol Display -->
              <span class="text-base sm:text-lg text-white group-hover:scale-105 transition-transform select-all font-mono min-h-[36px] flex items-center justify-center break-all px-1">
                {sym.char}
              </span>

              <!-- German Label -->
              <span class="text-[11px] text-stone-400 group-hover:text-stone-200 font-medium truncate max-w-full px-1" title={sym.germanLabel}>
                {sym.germanLabel}
              </span>

              <!-- Kopieren Button -->
              <button
                type="button"
                class="btn-copy-kaomoji-card w-full py-1.5 px-2 rounded-lg bg-white/5 group-hover:bg-amber-500/20 group-hover:text-amber-300 border border-white/10 group-hover:border-amber-500/40 text-xs font-bold text-stone-300 transition-all"
                data-char={sym.char}
                title={`"${sym.char}" kopieren`}
              >
                Kopieren
              </button>
            </div>
          ))}
        </div>
      </div>

      <!-- Cross Links to other Symbol categories & Silos -->
      <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-4">
        {NAVIGATION_DATA.symbols.items
          .filter((item) => !item.href.includes('emotikons'))
          .map((other) => (
            <a
              href={other.href}
              class="p-5 rounded-2xl bg-[#141412] border border-white/10 hover:border-amber-500/30 transition-all block group"
            >
              <div class="text-base font-bold text-white group-hover:text-amber-400 flex items-center justify-between">
                <span>{other.icon} {other.title}</span>
                <span>→</span>
              </div>
              <div class="text-xs text-stone-400 mt-1">{other.description}</div>
            </a>
          ))}
      </div>
    </div>
  </main>
</Layout>

<!-- Client Side Interactivity for Filterable Kaomojis Library -->
<script define:vars={{ totalSymbolsCount: totalCount }}>
  const kaomojisGrid = document.getElementById('kaomojis-library-grid');
  const countDisplay = document.getElementById('kaomoji-count-display');
  const categoryPills = document.querySelectorAll('.btn-kaomoji-cat');

  async function copyToClipboard(text) {
    if (!text) return;
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
      } else {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }
      window.dispatchEvent(new CustomEvent('show-toast'));
    } catch (err) {
      console.error('Copy error:', err);
    }
  }

  // 1. Client-Side Category Filtering
  categoryPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      categoryPills.forEach((p) => {
        p.classList.remove('bg-amber-500', 'text-black', 'shadow-md', 'shadow-amber-500/20');
        p.classList.add('bg-[#0a0a08]', 'text-stone-300', 'border', 'border-white/10');
      });
      pill.classList.remove('bg-[#0a0a08]', 'text-stone-300', 'border', 'border-white/10');
      pill.classList.add('bg-amber-500', 'text-black', 'shadow-md', 'shadow-amber-500/20');

      const selectedCategory = pill.getAttribute('data-category');
      const allCards = document.querySelectorAll('.kaomoji-card');
      let visibleCount = 0;

      allCards.forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        if (selectedCategory === 'all' || cardCat === selectedCategory) {
          (card).style.display = 'flex';
          visibleCount++;
        } else {
          (card).style.display = 'none';
        }
      });

      if (countDisplay) {
        if (selectedCategory === 'all') {
          countDisplay.textContent = `${totalSymbolsCount} Symbole verfügbar`;
        } else {
          countDisplay.textContent = `${visibleCount} von ${totalSymbolsCount} Symbolen`;
        }
      }
    });
  });

  // 2. Click Kaomoji Card / Copy Button
  kaomojisGrid?.addEventListener('click', (e) => {
    const copyBtn = e.target.closest('.btn-copy-kaomoji-card');
    const card = e.target.closest('.kaomoji-card');
    if (!card) return;

    const char = card.getAttribute('data-char');
    if (!char) return;

    copyToClipboard(char);

    const targetBtn = copyBtn || card.querySelector('.btn-copy-kaomoji-card');
    if (targetBtn) {
      const origText = targetBtn.textContent;
      targetBtn.textContent = 'Kopiert!';
      targetBtn.classList.add('bg-amber-500', 'text-black');
      setTimeout(() => {
        targetBtn.textContent = origText;
        targetBtn.classList.remove('bg-amber-500', 'text-black');
      }, 1500);
    }
  });
</script>
