  <!-- Client-side script for 1-click copy & category filtering -->
  <script is:inline>
    // Filter Functionality
    const catButtons = document.querySelectorAll('.btn-frame-cat');
    const cards = document.querySelectorAll('.frame-card');
    const countDisplay = document.getElementById('frame-count-display');

    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => {
          b.classList.remove('bg-cyan-500', 'text-black', 'shadow-md', 'shadow-cyan-500/20');
          b.classList.add('bg-[#0a0a08]', 'text-stone-300', 'border', 'border-white/10');
        });
        btn.classList.remove('bg-[#0a0a08]', 'text-stone-300', 'border', 'border-white/10');
        btn.classList.add('bg-cyan-500', 'text-black', 'shadow-md', 'shadow-cyan-500/20');

        const cat = btn.getAttribute('data-category');
        let visibleCount = 0;

        cards.forEach(card => {
          if (cat === 'alle' || card.getAttribute('data-category') === cat) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (countDisplay) {
          countDisplay.textContent = visibleCount + ' Symbole verfügbar';
        }
      });
    });

    // Copy Functionality on Cards
    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        const char = card.getAttribute('data-char');
        if (char) {
          navigator.clipboard.writeText(char).then(() => {
            const btn = card.querySelector('.btn-copy-frame span');
            if (btn) {
              const original = btn.textContent;
              btn.textContent = 'Kopiert! ✓';
              setTimeout(() => {
                btn.textContent = original;
              }, 1500);
            }
          });
        }
      });
    });

    // Inline Copy Buttons
    document.querySelectorAll('.btn-copy-inline').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-copy');
        if (text) {
          navigator.clipboard.writeText(text).then(() => {
            const original = btn.textContent;
            btn.textContent = 'Kopiert! ✓';
            setTimeout(() => {
              btn.textContent = original;
            }, 1500);
          });
        }
      });
    });
  </script>
