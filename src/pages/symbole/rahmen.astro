---
import Layout from '../../layouts/Layout.astro';
import GradientMeshBackground from '../../components/GradientMeshBackground.astro';
import FontStyleGrid from '../../components/FontStyleGrid.astro';
import { RAHMEN_CATEGORIES, RAHMEN_SYMBOLS_DATA } from '../../data/expanded-symbols-data';
import { NAVIGATION_DATA } from '../../data/navigation';

const totalCount = RAHMEN_SYMBOLS_DATA.length;

const frameFaqs = [
  {
    q: 'Kann ich Rahmen, Klammern & Flügel zum Kopieren direkt in Instagram verwenden?',
    a: 'Viele Unicode-Zeichen lassen sich in Profiltexten, Captions und Nachrichten einfügen. Ob ein bestimmtes Zeichen akzeptiert oder korrekt dargestellt wird, hängt jedoch von der jeweiligen Plattform ab.',
  },
  {
    q: 'Sind ʚɞ echte Flügel-Symbole?',
    a: 'ʚɞ wird häufig als Flügel- oder Schmetterlingsform verwendet. Es handelt sich aber nicht um ein offizielles Unicode-Emoji namens „Flügel“. Für das echte Schmetterlings-Emoji steht 🦋 (U+1F98B).',
  },
  {
    q: 'Welche Zeichen sind am kompatibelsten?',
    a: 'Einfache ASCII-Zeichen wie (), [] und {} sind für Klartext besonders robust. Dekorative Unicode-Zeichen bieten mehr Gestaltungsmöglichkeiten, sollten aber bei wichtigen oder technisch eingeschränkten Eingaben vorher getestet werden.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": frameFaqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a,
    },
  })),
};

const bracketTableData = [
  { type: 'Rund', char: '( Text )', suitableFor: 'normalen Text & Erklärungen' },
  { type: 'Eckig', char: '[ Text ]', suitableFor: 'Hinweise und kurze Labels' },
  { type: 'Geschweift', char: '{ Text }', suitableFor: 'Code oder dekorative Akzente' },
  { type: 'Spitze', char: '⟨ Text ⟩', suitableFor: 'mathematische oder technische Inhalte' },
  { type: 'Dekorativ', char: '❰ Text ❱', suitableFor: 'Bios und Nicknames' },
  { type: 'Geschwungen', char: '❴ Text ❵', suitableFor: 'dekorative Überschriften' },
];
---

<Layout
  title="Rahmen, Klammern & Flügel zum Kopieren – Schöne Symbole"
  description="Rahmen, Klammern & Flügel zum Kopieren: schöne Unicode-Zeichen für Bios, Nicknames, Chats und Social Media. Einfach auswählen, kopieren und einfügen."
  canonicalUrl="/symbole/rahmen/"
  schema={faqSchema}
>
  <main class="relative bg-[#0F1220] min-h-screen py-12 md:py-16 overflow-hidden homepage-mesh-wrapper text-white">
    <!-- Ornamental Frames & Wings Themed Gradient Mesh Layer -->
    <GradientMeshBackground variant="rahmen" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs sm:text-sm text-stone-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/symbole" class="hover:text-amber-400 transition-colors">Symbole</a>
        <span>/</span>
        <span class="text-stone-200">Rahmen &amp; Flügel</span>
      </nav>

      <!-- Page Header & H1 -->
      <div class="text-center max-w-4xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
          <span>꧁</span> 1-Klick Kopieren &bull; {totalCount} Rahmen, Klammern &amp; Flügel &bull; Unicode
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight mb-4">
          Rahmen, Klammern &amp; Flügel zum Kopieren
        </h1>
        <p class="text-base sm:text-lg text-stone-300 max-w-2xl mx-auto">
          Dekorative Rahmen, Klammern und flügelähnliche Zeichen direkt kopieren und für Bios, Nicknames, Chats und Social Media verwenden.
        </p>
      </div>

      <!-- Filterable Interactive Frames Library -->
      <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl mb-16">
        <!-- Section Header with Dynamic Counter -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-white/5">
          <div>
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>꧁</span> Rahmen, Klammern &amp; Flügel Bibliothek
            </h2>
            <p class="text-xs text-stone-400 mt-1">
              Wähle eine Kategorie, um die Klammern und Flügel zu filtern, oder klicke direkt auf ein Symbol zum Kopieren:
            </p>
          </div>
          <span
            id="frame-count-display"
            class="px-3 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-semibold shrink-0 self-start sm:self-center"
          >
            {totalCount} Symbole verfügbar
          </span>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap gap-2 mb-8" id="frame-category-pills">
          {RAHMEN_CATEGORIES.map((cat, idx) => (
            <button
              type="button"
              class={`btn-frame-cat px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 focus:outline-none ${
                idx === 0
                  ? 'bg-cyan-500 text-black shadow-md shadow-cyan-500/20'
                  : 'bg-[#0a0a08] text-stone-300 border border-white/10 hover:border-cyan-500/40 hover:text-white'
              }`}
              data-category={cat.id}
            >
              <span>{cat.icon}</span>
              <span>{cat.name}</span>
            </button>
          ))}
        </div>

        <!-- Symbol Cards Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3.5" id="frames-library-grid">
          {RAHMEN_SYMBOLS_DATA.map((sym) => (
            <div
              class="frame-card p-4 rounded-2xl bg-[#0a0a08] border border-white/5 hover:border-cyan-500/40 hover:-translate-y-0.5 transition-all flex flex-col items-center justify-between gap-3 group text-center cursor-pointer"
              data-char={sym.char}
              data-category={sym.category}
            >
              <!-- Symbol Display -->
              <span class="text-2xl sm:text-3xl text-white group-hover:scale-110 transition-transform select-all font-mono min-h-[36px] flex items-center justify-center">
                {sym.char}
              </span>

              <!-- German Label -->
              <span class="text-[11px] text-stone-400 group-hover:text-stone-200 font-medium truncate max-w-full px-1" title={sym.germanLabel}>
                {sym.germanLabel}
              </span>

              <!-- Kopieren Button -->
              <button
                type="button"
                class="btn-copy-frame w-full py-1.5 px-3 rounded-lg bg-white/5 hover:bg-cyan-500 hover:text-black border border-white/10 hover:border-cyan-500 text-xs font-semibold text-stone-300 transition-all flex items-center justify-center gap-1"
                aria-label={`Kopiere ${sym.germanLabel}`}
              >
                <span>Kopieren</span>
              </button>
            </div>
          ))}
        </div>
      </div>

      <!-- Content Grid: Left Column (Editorial Article) & Right Sidebar -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- LEFT COLUMN (lg:col-span-2): Editorial Article Content -->
        <div class="lg:col-span-2 space-y-8">

          <!-- IMAGE 1: Featured Hero Image -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl overflow-hidden shadow-2xl">
            <img
              src="/images/rahmen-fluegel-hero.svg"
              alt="Rahmen Klammern und Flügel Symbole zum Kopieren"
              class="w-full h-auto aspect-video object-cover"
              loading="eager"
            />
            <p class="text-xs text-stone-400 p-3 text-center border-t border-white/5 bg-[#0a0a08]">
              Dekorative Rahmen, Klammern und flügelähnliche Zeichen für kreative Texte.
            </p>
          </div>

          <!-- Section 1: Intro -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Wer dekorative Zeichen für eine Bio, einen Nickname oder eine Nachricht sucht, möchte meist nicht lange nach passenden Formen suchen. <strong>Rahmen, Klammern &amp; Flügel zum Kopieren</strong> sind praktisch, weil du die Zeichen direkt auswählen und in dein Textfeld einfügen kannst. Besonders beliebt sind symmetrische Zeichen, die einen Namen oder kurzen Text optisch hervorheben.
            </p>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Dabei ist die Auswahl groß. Manche Zeichen bilden echte Rahmen, andere funktionieren als einzelne Klammern oder als dekorative Flügel- und Schmetterlingsformen. Deshalb ist es hilfreich, die passenden Varianten nach Zweck zu wählen. Hier findest du eine kompakte Sammlung und Tipps für die Verwendung. Entdecke auch unsere <a href="/symbole" class="text-cyan-400 hover:underline font-semibold">Symbole &amp; Emojis Übersicht</a>.
            </p>
          </div>

          <!-- Section 2: Dekorative Rahmen -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              Dekorative Rahmen
            </h2>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Diese Kombinationen eignen sich gut für Namen, kurze Überschriften und Profiltexte:
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="font-mono font-bold text-cyan-300 text-sm block mb-1">꧁ Text ꧂</span>
                <span class="text-[10px] text-stone-400">Ranken-Rahmen</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="font-mono font-bold text-purple-300 text-sm block mb-1">༺ Text ༻</span>
                <span class="text-[10px] text-stone-400">Florale Schwingen</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="font-mono font-bold text-pink-300 text-sm block mb-1">『 Text 』</span>
                <span class="text-[10px] text-stone-400">Winkelklammern</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="font-mono font-bold text-amber-300 text-sm block mb-1">【 Text 】</span>
                <span class="text-[10px] text-stone-400">Schwarze Box-Klammer</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="font-mono font-bold text-emerald-300 text-sm block mb-1">〖 Text 〗</span>
                <span class="text-[10px] text-stone-400">Hohle Box-Klammer</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="font-mono font-bold text-blue-300 text-sm block mb-1">〘 Text 〙</span>
                <span class="text-[10px] text-stone-400">Schild-Klammern</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="font-mono font-bold text-indigo-300 text-sm block mb-1">⟦ Text ⟧</span>
                <span class="text-[10px] text-stone-400">Doppelklammer</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="font-mono font-bold text-rose-300 text-sm block mb-1">❴ Text ❵</span>
                <span class="text-[10px] text-stone-400">Zierklammern</span>
              </div>
            </div>

            <p class="text-sm sm:text-base text-stone-300 leading-relaxed pt-2">
              Für einfache Textboxen kannst du auch Linienzeichen kombinieren:
            </p>

            <div class="bg-[#0a0a08] border border-white/10 rounded-2xl p-4 font-mono text-sm text-cyan-300 max-w-xs mx-auto text-center">
              <p>┌──────────┐</p>
              <p>│ Dein Text │</p>
              <p>└──────────┘</p>
            </div>

            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Der <a href="https://www.unicode.org/versions/Unicode17.0.0/core-spec/chapter-22/" target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:text-cyan-300 underline font-semibold">Unicode-Standard</a> enthält dafür einen eigenen Bereich mit Box-Drawing-Zeichen. Dazu gehören leichte, schwere und doppelte Linien sowie verschiedene Eckstücke.
            </p>
          </div>

          <!-- IMAGE 2: Eckzeichen Stile Visual -->
          <div class="rounded-2xl overflow-hidden border border-white/10">
            <img
              src="/images/rahmen-fluegel-eckzeichen-stile.svg"
              alt="Verschiedene Unicode Rahmen und Eckzeichen"
              class="w-full h-auto aspect-video object-cover"
              loading="lazy"
            />
            <p class="text-xs text-stone-400 p-2.5 text-center bg-[#0a0a08] border-t border-white/5">
              Unterschiedliche Rahmen- und Eckzeichen für Textlayouts.
            </p>
          </div>

          <!-- Section 3: Klammern und Schmuckklammern -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              Klammern und Schmuckklammern
            </h2>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Wenn du eher einzelne Zeichenpaare suchst, sind diese Varianten nützlich:
            </p>

            <!-- Table of 6 Bracket Types -->
            <div class="overflow-x-auto my-4 border border-white/10 rounded-2xl">
              <table class="w-full text-left text-sm text-stone-300">
                <thead class="bg-white/5 text-xs uppercase text-stone-400">
                  <tr>
                    <th scope="col" class="px-4 py-3">Typ</th>
                    <th scope="col" class="px-4 py-3">Zeichen</th>
                    <th scope="col" class="px-4 py-3">Geeignet für</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                  {bracketTableData.map((item) => (
                    <tr class="hover:bg-white/5">
                      <td class="px-4 py-3 font-semibold text-white">{item.type}</td>
                      <td class="px-4 py-3 font-mono text-base font-bold text-cyan-400">{item.char}</td>
                      <td class="px-4 py-3 text-stone-300">{item.suitableFor}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <p class="text-xs sm:text-sm text-stone-400 leading-relaxed">
              Die einfachen Zeichen (), [] und {} sind besonders praktisch, wenn Kompatibilität wichtiger ist als ein ausgefallener Look. Dekorative Varianten können dagegen je nach Schrift und App anders dargestellt werden. Entdecke auch unsere <a href="/schrift/eckige-schrift" class="text-cyan-400 hover:underline font-semibold">Eckige Schriftarten</a>.
            </p>
          </div>

          <!-- Section 4: Flügel- und Schmetterlingszeichen -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              Flügel- und Schmetterlingszeichen
            </h2>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Für einen leichten, ästhetischen Stil kannst du flügelähnliche Kombinationen verwenden:
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="text-xl block mb-1 font-mono text-pink-400">ʚɞ</span>
                <span class="text-xs text-stone-300">Flügel</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="text-xl block mb-1 font-mono text-emerald-400">ʚ✿ɞ</span>
                <span class="text-xs text-stone-300">Blüten-Flügel</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="text-xl block mb-1 font-mono text-pink-300">ʚ♡ɞ</span>
                <span class="text-xs text-stone-300">Herz-Flügel</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="text-xl block mb-1 font-mono text-cyan-300">ʚ・ɞ</span>
                <span class="text-xs text-stone-300">Zarte Schwingen</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="text-xl block mb-1 font-mono text-purple-300">୨୧</span>
                <span class="text-xs text-stone-300">Schleife (Bow)</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center">
                <span class="text-xl block mb-1 font-mono text-rose-300">༺♡༻</span>
                <span class="text-xs text-stone-300">Florales Herz</span>
              </div>
              <div class="bg-[#1a1a16] border border-white/5 rounded-xl p-3 text-center sm:col-span-2">
                <span class="text-xl block mb-1 font-mono text-amber-300">꧁♡꧂</span>
                <span class="text-xs text-stone-300">Ranken-Herz</span>
              </div>
            </div>

            <p class="text-sm sm:text-base text-stone-300 leading-relaxed pt-2">
              Wichtig ist die Unterscheidung zwischen einem echten Emoji und einer dekorativen Textkombination. 🦋 ist das Unicode-Emoji „butterfly“ mit dem Codepunkt U+1F98B. Formen wie <code>ʚɞ</code> werden dagegen als flügelähnliche Textzeichen oder dekorative Kombinationen verwendet. Kombiniere sie auch mit unseren <a href="/symbole/herzen" class="text-pink-400 hover:underline font-semibold">Herz-Symbolen zum Kopieren</a>.
            </p>
          </div>

          <!-- IMAGE 3: Schmetterling & Flügel Visual -->
          <div class="rounded-2xl overflow-hidden border border-white/10">
            <img
              src="/images/rahmen-fluegel-schmetterling-aesthetic.svg"
              alt="Flügel und Schmetterlingszeichen als dekorative Textsymbole"
              class="w-full h-auto aspect-video object-cover"
              loading="lazy"
            />
            <p class="text-xs text-stone-400 p-2.5 text-center bg-[#0a0a08] border-t border-white/5">
              Flügelähnliche Zeichen eignen sich besonders für Bios, Nicknames und kurze Nachrichten.
            </p>
          </div>

          <!-- Section 5: So verwendest du die Zeichen richtig -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              So verwendest du die Zeichen richtig
            </h2>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Rahmen, Klammern &amp; Flügel zum Kopieren funktionieren am einfachsten mit Copy &amp; Paste. Markiere eine gewünschte Kombination, kopiere sie und füge sie anschließend in das Zielfeld ein.
            </p>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Für Social Media eignen sich kurze Kombinationen besonders gut. Ein Name wie <code>꧁Luna꧂</code> bleibt übersichtlich und schnell erfassbar.
            </p>
            <p class="text-sm sm:text-base text-stone-300 leading-relaxed">
              Bei Profilnamen, Formularen oder technischen Eingaben solltest du zuerst prüfen, welche Zeichen erlaubt sind. Auch die Darstellung kann sich zwischen Apps und Schriftarten unterscheiden.
            </p>
          </div>

          <!-- Section 6: Gute Kombinationen für verschiedene Zwecke -->
          <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              Gute Kombinationen für verschiedene Zwecke
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
              
              <!-- Instagram Bios -->
              <div class="bg-[#1a1a16] border border-white/5 rounded-2xl p-4 space-y-2">
                <span class="text-xs font-bold text-pink-400 uppercase tracking-wider block">
                  Für Instagram-Bios (siehe <a href="/plattform/instagram" class="underline hover:text-pink-300">Instagram-Schriftarten</a>)
                </span>
                <div class="text-xs text-stone-300 space-y-1.5 font-mono">
                  <p class="flex justify-between items-center"><span>ʚ♡ɞ Dreamer ʚ♡ɞ</span> <button class="btn-copy-inline px-2 py-0.5 bg-white/5 hover:bg-pink-500 hover:text-white rounded text-[11px]" data-copy="ʚ♡ɞ Dreamer ʚ♡ɞ">Kopieren</button></p>
                  <p class="flex justify-between items-center"><span>꧁ Luna ꧂</span> <button class="btn-copy-inline px-2 py-0.5 bg-white/5 hover:bg-pink-500 hover:text-white rounded text-[11px]" data-copy="꧁ Luna ꧂">Kopieren</button></p>
                  <p class="flex justify-between items-center"><span>『 Aesthetic 』</span> <button class="btn-copy-inline px-2 py-0.5 bg-white/5 hover:bg-pink-500 hover:text-white rounded text-[11px]" data-copy="『 Aesthetic 』">Kopieren</button></p>
                </div>
              </div>

              <!-- Gaming Namen -->
              <div class="bg-[#1a1a16] border border-white/5 rounded-2xl p-4 space-y-2">
                <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider block">
                  Für Gaming-Namen (siehe <a href="/spiele/fortnite-nickname" class="underline hover:text-cyan-300">Fortnite-Nicknames</a>)
                </span>
                <div class="text-xs text-stone-300 space-y-1.5 font-mono">
                  <p class="flex justify-between items-center"><span>꧁༺ Shadow ༻꧂</span> <button class="btn-copy-inline px-2 py-0.5 bg-white/5 hover:bg-cyan-500 hover:text-black rounded text-[11px]" data-copy="꧁༺ Shadow ༻꧂">Kopieren</button></p>
                  <p class="flex justify-between items-center"><span>『 Viper 』</span> <button class="btn-copy-inline px-2 py-0.5 bg-white/5 hover:bg-cyan-500 hover:text-black rounded text-[11px]" data-copy="『 Viper 』">Kopieren</button></p>
                  <p class="flex justify-between items-center"><span>〘Nova〙</span> <button class="btn-copy-inline px-2 py-0.5 bg-white/5 hover:bg-cyan-500 hover:text-black rounded text-[11px]" data-copy="〘Nova〙">Kopieren</button></p>
                </div>
              </div>

              <!-- WhatsApp & Chats -->
              <div class="bg-[#1a1a16] border border-white/5 rounded-2xl p-4 space-y-2">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block">Für WhatsApp und Chats</span>
