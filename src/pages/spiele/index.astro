---
import Layout from '../../layouts/Layout.astro';
import GradientMeshBackground from '../../components/GradientMeshBackground.astro';
import { GAMES_DATA } from '../../data/game-metadata';
import { SITE_CONFIG } from '../../config/site';

const gameIcons: Record<string, string> = {
  fortnite: '🎯',
  minecraft: '⛏️',
  valorant: '🔥',
  roblox: '🕹️',
  'free-fire': '🏆',
  cs2: '💣',
};

const gamesList = Object.values(GAMES_DATA).map((game) => ({
  ...game,
  icon: gameIcons[game.id] || '🎮',
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Gaming Nickname Generator – Fortnite, Minecraft, Valorant & mehr',
  description: 'Erstelle stylische Gamertags, Clantags und Nicknames für die beliebtesten Games im DACH-Raum.',
  url: `${SITE_CONFIG.baseUrl}/spiele`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: gamesList.map((game, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: game.name,
      url: `${SITE_CONFIG.baseUrl}${game.slug}`,
    })),
  },
};
---

<Layout
  title="Gaming Nickname Generator – Fortnite, Minecraft, Valorant & mehr | Schriftarten.io"
  description="Gaming Nickname Generator für Fortnite, Minecraft, Valorant, Roblox, Free Fire und CS2. Kostenlos epische Gamertags, Clannamen und Symbole kopieren."
  canonicalUrl="/spiele"
  schema={schema}
>
  <main class="relative bg-[#0F1220] min-h-screen py-12 md:py-16 overflow-hidden homepage-mesh-wrapper">
    <!-- Reusable Multi-Color Gradient Mesh Layer -->
    <GradientMeshBackground />

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-stone-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Startseite</a>
        <span>/</span>
        <span class="text-stone-300 font-semibold">Spiele</span>
      </nav>

      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider mb-4">
          <span>🎮 Gaming Nickname Generatoren</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Gaming Nickname Generator – Fortnite, Minecraft, Valorant & mehr
        </h1>
        <p class="mt-4 text-base sm:text-lg text-stone-300 leading-relaxed">
          Erstelle stylische Gamertags, Clantags und Nicknames für die beliebtesten Games im DACH-Raum. Wähle dein Spiel aus, um sofort kopierbare Namen, Engelsflügel, Schwerter und filter-sichere Unicode-Kombinationen zu entdecken.
        </p>
      </div>

      <!-- 6 Game Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {gamesList.map((game) => (
          <a
            href={game.slug}
            class="group block p-7 rounded-3xl bg-[#141412] border border-white/10 hover:border-amber-500/40 shadow-xl hover:shadow-2xl hover:shadow-amber-500/10 transition-all duration-200 relative overflow-hidden"
          >
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
                {game.icon}
              </div>
              <span class="text-[11px] font-bold px-3 py-1 rounded-full bg-white/5 border border-white/10 text-stone-300 group-hover:bg-amber-500/20 group-hover:text-amber-300 group-hover:border-amber-500/30 transition-colors">
                {game.genre}
              </span>
            </div>

            <h2 class="text-xl font-bold text-white group-hover:text-amber-400 transition-colors mb-2 flex items-center justify-between">
              <span>{game.name} Nicknames</span>
              <span class="text-stone-500 group-hover:text-amber-400 group-hover:translate-x-1 transition-all">→</span>
            </h2>

            <p class="text-xs sm:text-sm text-stone-400 leading-relaxed mb-5">
              {game.description}
            </p>

            <!-- Sample Nickname Preview -->
            <div class="p-3 rounded-2xl bg-[#0a0a08] border border-white/5 group-hover:border-amber-500/30 transition-colors">
              <div class="text-[10px] font-bold uppercase tracking-wider text-stone-500 mb-1">Beispiel-Nickname:</div>
              <div class="text-xs font-mono font-bold text-amber-400 truncate">
                {game.exampleNicknames[0]}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
