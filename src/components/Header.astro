---
import { NAVIGATION_DATA } from '../data/navigation';
import { SITE_CONFIG } from '../config/site';
---

<header class="fixed top-0 left-0 right-0 z-50 h-16 bg-[#0a0a08]/90 backdrop-blur-xl border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-full flex justify-between items-center">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 group focus:outline-none" aria-label="Zur Startseite">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center text-black font-extrabold text-lg shadow-md shadow-amber-500/20">
        𝔖
      </div>
      <div class="flex items-center tracking-tight">
        <span class="text-white font-bold text-base group-hover:text-amber-400 transition-colors">Schriftarten</span>
        <span class="text-amber-500 font-bold text-base">.io</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Hauptnavigation">
      <!-- 1. Schriftarten Dropdown -->
      <div class="relative group">
        <a
          href={NAVIGATION_DATA.fontStyles.href}
          class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-stone-300 hover:text-white rounded-lg hover:bg-white/5 transition-colors focus:outline-none"
        >
          <span>{NAVIGATION_DATA.fontStyles.label}</span>
          <svg class="w-3.5 h-3.5 text-stone-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-72">
          <div class="bg-[#141412] border border-white/10 rounded-2xl p-2 shadow-2xl shadow-black/80 backdrop-blur-xl">
            <div class="flex items-center justify-between px-3 py-1.5 border-b border-white/5 mb-1">
              <span class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider">14 Typografische Stile</span>
              <a href="/schrift" class="text-[11px] font-bold text-amber-400 hover:underline">Alle →</a>
            </div>
            <div class="max-h-96 overflow-y-auto space-y-0.5 scrollbar-thin">
              {NAVIGATION_DATA.fontStyles.items.map((item) => (
                <a
                  href={item.href}
                  class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-sm font-medium text-stone-200 hover:text-white hover:bg-amber-500/10 hover:border-amber-500/30 border border-transparent transition-all"
                >
                  <span class="w-6 text-center text-amber-400 font-bold font-mono">{item.icon}</span>
                  <span class="truncate">{item.title}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Plattformen Dropdown -->
      <div class="relative group">
        <a
          href={NAVIGATION_DATA.platforms.href}
          class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-stone-300 hover:text-white rounded-lg hover:bg-white/5 transition-colors focus:outline-none"
        >
          <span>{NAVIGATION_DATA.platforms.label}</span>
          <svg class="w-3.5 h-3.5 text-stone-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-64">
          <div class="bg-[#141412] border border-white/10 rounded-2xl p-2 shadow-2xl shadow-black/80 backdrop-blur-xl">
            <div class="flex items-center justify-between px-3 py-1.5 border-b border-white/5 mb-1">
              <span class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider">Social Media & Apps</span>
              <a href="/plattform" class="text-[11px] font-bold text-amber-400 hover:underline">Alle →</a>
            </div>
            <div class="space-y-0.5">
              {NAVIGATION_DATA.platforms.items.map((item) => (
                <a
                  href={item.href}
                  class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-sm font-medium text-stone-200 hover:text-white hover:bg-amber-500/10 hover:border-amber-500/30 border border-transparent transition-all"
                >
                  <span class="text-base">{item.icon}</span>
                  <span class="truncate">{item.title}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Spiele Dropdown -->
      <div class="relative group">
        <a
          href={NAVIGATION_DATA.games.href}
          class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-stone-300 hover:text-white rounded-lg hover:bg-white/5 transition-colors focus:outline-none"
        >
          <span>{NAVIGATION_DATA.games.label}</span>
          <svg class="w-3.5 h-3.5 text-stone-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-64">
          <div class="bg-[#141412] border border-white/10 rounded-2xl p-2 shadow-2xl shadow-black/80 backdrop-blur-xl">
            <div class="flex items-center justify-between px-3 py-1.5 border-b border-white/5 mb-1">
              <span class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider">Gaming Nicknames</span>
              <a href="/spiele" class="text-[11px] font-bold text-amber-400 hover:underline">Alle →</a>
            </div>
            <div class="space-y-0.5">
              {NAVIGATION_DATA.games.items.map((item) => (
                <a
                  href={item.href}
                  class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-sm font-medium text-stone-200 hover:text-white hover:bg-amber-500/10 hover:border-amber-500/30 border border-transparent transition-all"
                >
                  <span class="text-base">{item.icon}</span>
                  <span class="truncate">{item.title}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Symbole Dropdown -->
      <div class="relative group">
        <a
          href={NAVIGATION_DATA.symbols.href}
          class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-stone-300 hover:text-white rounded-lg hover:bg-white/5 transition-colors focus:outline-none"
        >
          <span>{NAVIGATION_DATA.symbols.label}</span>
          <svg class="w-3.5 h-3.5 text-stone-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-64">
          <div class="bg-[#141412] border border-white/10 rounded-2xl p-2 shadow-2xl shadow-black/80 backdrop-blur-xl">
            <div class="flex items-center justify-between px-3 py-1.5 border-b border-white/5 mb-1">
              <span class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider">Symbole & Emojis</span>
              <a href="/symbole" class="text-[11px] font-bold text-amber-400 hover:underline">Alle →</a>
            </div>
            <div class="space-y-0.5">
              {NAVIGATION_DATA.symbols.items.map((item) => (
                <a
                  href={item.href}
                  class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-sm font-medium text-stone-200 hover:text-white hover:bg-amber-500/10 hover:border-amber-500/30 border border-transparent transition-all"
                >
                  <span class="text-base">{item.icon}</span>
                  <span class="truncate">{item.title}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Direct Blog Link -->
      <a
        href={NAVIGATION_DATA.blog.href}
        class="px-3 py-2 text-sm font-medium text-amber-400 hover:text-amber-300 rounded-lg hover:bg-amber-500/10 transition-colors flex items-center gap-1.5"
      >
        <span>📖 Blog</span>
      </a>
    </nav>

    <!-- Header Actions (Dark Mode Toggle & Mobile Menu Trigger) -->
    <div class="flex items-center gap-3">
      <!-- Dark/Light Mode Switcher -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="p-2 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 text-stone-300 hover:text-white transition-all focus:outline-none"
        aria-label="Farbschema wechseln"
        title="Dunkel / Hell umschalten"
      >
        <svg id="moon-icon" class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <svg id="sun-icon" class="w-4 h-4 text-amber-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-open-btn"
        type="button"
        class="lg:hidden p-2 rounded-xl border border-amber-500/20 bg-amber-500/10 text-amber-400 hover:bg-amber-500/20 transition-all focus:outline-none"
        aria-label="Menü öffnen"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-50 bg-black/95 backdrop-blur-2xl hidden flex-col transition-all duration-300"
>
  <!-- Drawer Header -->
  <div class="h-16 px-6 border-b border-white/10 flex justify-between items-center">
    <div class="flex items-center gap-2">
      <div class="w-7 h-7 rounded-md bg-amber-500 flex items-center justify-center text-black font-extrabold text-sm">
        𝔖
      </div>
      <span class="text-white font-bold text-sm">Navigation</span>
    </div>

    <button
      id="mobile-menu-close-btn"
      type="button"
      class="p-2 rounded-xl text-stone-400 hover:text-white border border-white/10 bg-white/5 focus:outline-none"
      aria-label="Menü schließen"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer Body (Scrollable) -->
  <div class="flex-1 overflow-y-auto px-6 py-6 space-y-6">
    <!-- Schriftarten -->
    <div>
      <a href="/schrift" class="mobile-link text-xs font-bold uppercase tracking-wider text-amber-500 hover:text-amber-400 mb-3 flex items-center justify-between">
        <span>Schriftarten</span>
        <span class="text-[11px] font-normal text-stone-400">Übersicht →</span>
      </a>
      <div class="grid grid-cols-2 gap-2">
        {NAVIGATION_DATA.fontStyles.items.map((item) => (
          <a
            href={item.href}
            class="mobile-link flex items-center gap-2 p-2.5 rounded-xl bg-white/5 border border-white/5 text-xs font-semibold text-stone-200 hover:border-amber-500/40"
          >
            <span class="text-amber-400 font-mono">{item.icon}</span>
            <span class="truncate">{item.title}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Plattformen -->
    <div>
      <a href="/plattform" class="mobile-link text-xs font-bold uppercase tracking-wider text-amber-500 hover:text-amber-400 mb-3 flex items-center justify-between">
        <span>Plattformen</span>
        <span class="text-[11px] font-normal text-stone-400">Übersicht →</span>
      </a>
      <div class="grid grid-cols-2 gap-2">
        {NAVIGATION_DATA.platforms.items.map((item) => (
          <a
            href={item.href}
            class="mobile-link flex items-center gap-2 p-2.5 rounded-xl bg-white/5 border border-white/5 text-xs font-semibold text-stone-200 hover:border-amber-500/40"
          >
            <span>{item.icon}</span>
            <span class="truncate">{item.title}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Spiele -->
    <div>
      <a href="/spiele" class="mobile-link text-xs font-bold uppercase tracking-wider text-amber-500 hover:text-amber-400 mb-3 flex items-center justify-between">
        <span>Gaming</span>
        <span class="text-[11px] font-normal text-stone-400">Übersicht →</span>
      </a>
      <div class="grid grid-cols-2 gap-2">
        {NAVIGATION_DATA.games.items.map((item) => (
          <a
            href={item.href}
            class="mobile-link flex items-center gap-2 p-2.5 rounded-xl bg-white/5 border border-white/5 text-xs font-semibold text-stone-200 hover:border-amber-500/40"
          >
            <span>{item.icon}</span>
            <span class="truncate">{item.title}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Symbole & Blog -->
    <div>
      <a href="/symbole" class="mobile-link text-xs font-bold uppercase tracking-wider text-amber-500 hover:text-amber-400 mb-3 flex items-center justify-between">
        <span>Symbole & Blog</span>
        <span class="text-[11px] font-normal text-stone-400">Übersicht →</span>
      </a>
      <div class="grid grid-cols-2 gap-2">
        {NAVIGATION_DATA.symbols.items.map((item) => (
          <a
            href={item.href}
            class="mobile-link flex items-center gap-2 p-2.5 rounded-xl bg-white/5 border border-white/5 text-xs font-semibold text-stone-200 hover:border-amber-500/40"
          >
            <span>{item.icon}</span>
            <span class="truncate">{item.title}</span>
          </a>
        ))}
        <a
          href="/blog"
          class="mobile-link flex items-center gap-2 p-2.5 rounded-xl bg-amber-500/15 border border-amber-500/30 text-xs font-semibold text-amber-300 col-span-2"
        >
          <span>📖</span>
          <span>Blog & E-E-A-T Ratgeber</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  // Theme Toggle Logic
  function initHeaderTheme() {
    const toggleBtn = document.getElementById('theme-toggle-btn');
    const moonIcon = document.getElementById('moon-icon');
    const sunIcon = document.getElementById('sun-icon');

    function applyTheme(theme: string) {
      if (theme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
        moonIcon?.classList.add('hidden');
        sunIcon?.classList.remove('hidden');
      } else {
        document.documentElement.removeAttribute('data-theme');
        moonIcon?.classList.remove('hidden');
        sunIcon?.classList.add('hidden');
      }
    }

    function syncTheme() {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light' || localStorage.getItem('theme') === 'light';
      applyTheme(isLight ? 'light' : 'dark');
    }

    syncTheme();

    if (toggleBtn && !(toggleBtn as any)._hasThemeListener) {
      (toggleBtn as any)._hasThemeListener = true;
      toggleBtn.addEventListener('click', () => {
        const isCurrentlyLight = document.documentElement.getAttribute('data-theme') === 'light';
        const newTheme = isCurrentlyLight ? 'dark' : 'light';
        try {
          localStorage.setItem('theme', newTheme);
        } catch (e) {}
        applyTheme(newTheme);
      });
    }
  }

  initHeaderTheme();
  document.addEventListener('astro:page-load', initHeaderTheme);
  document.addEventListener('astro:after-swap', initHeaderTheme);

  // Mobile Drawer Toggle Logic
  const drawer = document.getElementById('mobile-drawer');
  const openBtn = document.getElementById('mobile-menu-open-btn');
  const closeBtn = document.getElementById('mobile-menu-close-btn');

  function openDrawer() {
    drawer?.classList.remove('hidden');
    drawer?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer?.classList.add('hidden');
    drawer?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', closeDrawer);
  });
</script>
