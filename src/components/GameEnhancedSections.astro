---
import type { GameSectionsConfig } from '../data/game-nicknames';

interface Props {
  gameData: GameSectionsConfig;
  gameId: string;
}

const { gameData, gameId } = Astro.props;
const { section1, section2, section3, section4 } = gameData;
---

<div class="game-enhanced-sections-wrapper space-y-8 w-full" data-game-id={gameId}>
  <!-- ========================================================= -->
  <!-- SECTION 1: Sofort kopierbare Nicknames -->
  <!-- ========================================================= -->
  <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-xl">
    <div class="flex items-center justify-between flex-wrap gap-2 mb-2">
      <h2 class="text-xl font-bold text-white flex items-center gap-2">
        <span>⚡</span> {section1.title}
      </h2>
      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400">
        1-Klick Kopieren
      </span>
    </div>
    <p class="text-xs sm:text-sm text-stone-400 mb-6">
      {section1.intro}
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {section1.nicknames.map((nick) => (
        <div class="p-3.5 rounded-2xl bg-[#0a0a08] border border-white/5 hover:border-amber-500/30 transition-all flex items-center justify-between gap-3 group">
          <span class="text-xs sm:text-sm text-stone-100 font-bold font-mono truncate select-all">{nick}</span>
          <button
            type="button"
            class="btn-copy-game-nick shrink-0 px-3.5 py-1.5 rounded-lg bg-white/5 hover:bg-amber-500 hover:text-black border border-white/10 hover:border-amber-500 text-xs font-bold text-stone-300 transition-all"
            data-text={nick}
            title="In Zwischenablage kopieren"
          >
            Kopieren
          </button>
        </div>
      ))}
    </div>

    {section1.disclaimer && (
      <div class="mt-4 pt-3 border-t border-white/5 text-[11px] text-stone-500">
        * {section1.disclaimer}
      </div>
    )}
  </div>

  <!-- ========================================================= -->
  <!-- SECTION 2: Weitere fertige Nicknames -->
  <!-- ========================================================= -->
  <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-xl">
    <div class="flex items-center justify-between flex-wrap gap-2 mb-2">
      <h2 class="text-xl font-bold text-white flex items-center gap-2">
        <span>✨</span> {section2.title}
      </h2>
      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400">
        Kursive & Gotische Stile
      </span>
    </div>
    <p class="text-xs sm:text-sm text-stone-400 mb-6">
      {section2.intro}
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {section2.nicknames.map((nick) => (
        <div class="p-3.5 rounded-2xl bg-[#0a0a08] border border-white/5 hover:border-amber-500/30 transition-all flex items-center justify-between gap-3 group">
          <span class="text-xs sm:text-sm text-stone-100 font-bold font-mono truncate select-all">{nick}</span>
          <button
            type="button"
            class="btn-copy-game-nick shrink-0 px-3.5 py-1.5 rounded-lg bg-white/5 hover:bg-amber-500 hover:text-black border border-white/10 hover:border-amber-500 text-xs font-bold text-stone-300 transition-all"
            data-text={nick}
            title="In Zwischenablage kopieren"
          >
            Kopieren
          </button>
        </div>
      ))}
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- SECTION 3: Inspirierende Namen nach Kategorie + Symbole -->
  <!-- ========================================================= -->
  <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-xl">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-white flex items-center gap-2 mb-2">
        <span>🎯</span> {section3.title}
      </h2>
      <p class="text-xs sm:text-sm text-stone-400">
        {section3.intro}
      </p>
    </div>

    <!-- 8 Categorized Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      {section3.categories.map((cat) => (
        <div class="p-4 rounded-2xl bg-[#0a0a08] border border-white/5 hover:border-amber-500/30 transition-all">
          <h3 class="text-sm font-bold text-amber-400 mb-3 flex items-center gap-1.5">
            <span>{cat.icon}</span>
            <span>{cat.title}</span>
          </h3>
          <div class="space-y-2">
            {cat.names.map((name) => (
              <div class="flex items-center justify-between gap-2 p-2 rounded-xl bg-white/5 hover:bg-white/10 transition-colors">
                <span class="text-xs font-mono text-stone-200 truncate select-all">{name}</span>
                <button
                  type="button"
                  class="btn-copy-game-nick px-2.5 py-1 rounded-md bg-amber-500/10 hover:bg-amber-500 hover:text-black text-amber-400 text-[11px] font-bold transition-all shrink-0"
                  data-text={name}
                  title={`"${name}" kopieren`}
                >
                  Kopieren
                </button>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Game Symbole Mini-Tool -->
    <div class="pt-6 border-t border-white/10">
      <div class="flex items-center justify-between flex-wrap gap-2 mb-2">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <span>👑</span> {section3.symbolsTitle}
        </h3>
        <span class="text-xs text-amber-400 font-semibold">1-Klick Kopieren</span>
      </div>
      <p class="text-xs text-stone-400 mb-4">
        {section3.symbolsIntro}
      </p>

      <!-- Symbols Row Grid -->
      <div class="flex flex-wrap gap-2.5">
        {section3.symbols.map((sym) => (
          <button
            type="button"
            class="btn-copy-game-symbol p-2.5 sm:p-3 rounded-xl bg-[#0a0a08] border border-white/10 hover:border-amber-500 hover:bg-amber-500/10 text-lg sm:text-xl text-white hover:scale-110 active:scale-95 transition-all focus:outline-none"
            data-symbol={sym}
            title={`Symbol "${sym}" kopieren`}
          >
            {sym}
          </button>
        ))}
      </div>

      {section3.symbolTip && (
        <div class="mt-4 text-[11px] text-stone-400 flex items-center gap-1.5">
          <span class="text-amber-400">💡</span>
          <span>{section3.symbolTip}</span>
        </div>
      )}
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- SECTION 4: Einfachen Nickname selbst erstellen (Manueller Generator) -->
  <!-- ========================================================= -->
  <div class="bg-[#141412] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-xl">
    <div class="mb-4">
      <h2 class="text-xl font-bold text-white flex items-center gap-2 mb-2">
        <span>🛠️</span> {section4.title}
      </h2>
      <p class="text-xs sm:text-sm text-stone-400">
        {section4.intro}
      </p>
    </div>

    <!-- Generator Input -->
    <div class="mb-6">
      <label class="block text-xs font-bold uppercase tracking-wider text-amber-400 mb-2">
        Dein Basis-Name:
      </label>
      <input
        type="text"
        value={section4.defaultName}
        placeholder={section4.placeholder}
        maxlength="16"
        class="game-manual-input w-full bg-[#0a0a08] border-2 border-white/10 focus:border-amber-500 rounded-xl px-4 py-3 text-white text-sm sm:text-base font-medium focus:outline-none focus:ring-2 focus:ring-amber-500/20 transition-all"
      />
    </div>

    <!-- Live Combinations Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 game-manual-combos">
      <!-- Dynamically populated via client script -->
    </div>
  </div>
</div>

<!-- Embedded JSON variables for Client Script -->
<script define:vars={{ defaultBaseName: section4.defaultName }}>
  async function copyToClipboard(text) {
    if (!text) return;
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
      } else {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }
      window.dispatchEvent(new CustomEvent('show-toast'));
    } catch (err) {
      console.error('Copy error:', err);
    }
  }

  // Universal button copy handler
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.btn-copy-game-nick');
    if (btn) {
      const text = btn.getAttribute('data-text');
      if (text) {
        copyToClipboard(text);
        const origText = btn.textContent;
        btn.textContent = 'Kopiert!';
        btn.classList.add('bg-amber-500', 'text-black');
        setTimeout(() => {
          btn.textContent = origText;
          btn.classList.remove('bg-amber-500', 'text-black');
        }, 1500);
      }
    }

    const symBtn = e.target.closest('.btn-copy-game-symbol');
    if (symBtn) {
      const sym = symBtn.getAttribute('data-symbol');
      if (sym) {
        copyToClipboard(sym);
      }
    }
  });

  // Manual Generator Live Framing Logic
  const manualInput = document.querySelector('.game-manual-input');
  const combosContainer = document.querySelector('.game-manual-combos');

  const gameFrameTemplates = [
    (t) => `★ ${t} ★`,
    (t) => `『 ${t} 』`,
    (t) => `✦ ${t} ✦`,
    (t) => `꧁༺ ${t} ༻꧂`,
    (t) => `【 ${t} 】`,
    (t) => `⚡ ${t} ⚡`,
    (t) => `༺ ${t} ༻`,
    (t) => `┊ 𓆩 ${t} 𓆪 ┊`,
  ];

  function renderManualCombos() {
    if (!combosContainer) return;
    const name = manualInput?.value.trim() || defaultBaseName || 'NAME';
    combosContainer.innerHTML = gameFrameTemplates
      .map((tmpl) => {
        const framed = tmpl(name);
        return `
          <div class="p-3.5 rounded-2xl bg-[#0a0a08] border border-white/5 hover:border-amber-500/30 transition-all flex items-center justify-between gap-2.5">
            <span class="text-xs sm:text-sm text-stone-100 font-semibold truncate select-all font-mono">${framed}</span>
            <button
              type="button"
              class="btn-copy-game-nick shrink-0 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-amber-500 hover:text-black border border-white/10 hover:border-amber-500 text-xs font-bold text-stone-300 transition-all"
              data-text="${framed.replace(/"/g, '&quot;')}"
              title="Kombination kopieren"
            >
              Kopieren
            </button>
          </div>
        `;
      })
      .join('');
  }

  manualInput?.addEventListener('input', renderManualCombos);
  renderManualCombos();
</script>
