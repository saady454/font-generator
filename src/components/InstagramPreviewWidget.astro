---
// Instagram Preview Widget Component
---

<div class="bg-[#141412] border border-white/10 rounded-3xl p-5 sm:p-6 shadow-xl relative overflow-hidden" id="instagram-live-widget">
  <!-- Widget Header -->
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2">
      <span class="text-xl">📸</span>
      <h3 class="text-base font-bold text-white tracking-wide">
        Live Instagram-Vorschau
      </h3>
    </div>
    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-400 text-[10px] font-extrabold uppercase tracking-wider animate-pulse">
      <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
      Echtzeit
    </span>
  </div>

  <!-- Style Preset Switcher for Preview (Choose which transformation is shown in phone mockup) -->
  <div class="mb-4">
    <div class="text-[11px] font-bold text-stone-400 uppercase tracking-wider mb-2 flex items-center justify-between">
      <span>Vorschau-Schriftstil wählen:</span>
      <span id="ig-active-style-label" class="text-amber-400 font-semibold lowercase">fett sans</span>
    </div>
    <div class="flex flex-wrap gap-1.5" id="ig-style-pills">
      <button type="button" class="ig-style-pill active px-2.5 py-1 rounded-lg text-[11px] font-bold bg-amber-500 text-black shadow-sm transition-all" data-style="bold-sans">
        Fett
      </button>
      <button type="button" class="ig-style-pill px-2.5 py-1 rounded-lg text-[11px] font-bold bg-white/5 hover:bg-white/10 text-stone-300 hover:text-white border border-white/10 transition-all" data-style="italic">
        Kursiv
      </button>
      <button type="button" class="ig-style-pill px-2.5 py-1 rounded-lg text-[11px] font-bold bg-white/5 hover:bg-white/10 text-stone-300 hover:text-white border border-white/10 transition-all" data-style="script">
        Script
      </button>
      <button type="button" class="ig-style-pill px-2.5 py-1 rounded-lg text-[11px] font-bold bg-white/5 hover:bg-white/10 text-stone-300 hover:text-white border border-white/10 transition-all" data-style="small-caps">
        Kapitälchen
      </button>
      <button type="button" class="ig-style-pill px-2.5 py-1 rounded-lg text-[11px] font-bold bg-white/5 hover:bg-white/10 text-stone-300 hover:text-white border border-white/10 transition-all" data-style="bubble">
        Bubbles
      </button>
      <button type="button" class="ig-style-pill px-2.5 py-1 rounded-lg text-[11px] font-bold bg-white/5 hover:bg-white/10 text-stone-300 hover:text-white border border-white/10 transition-all" data-style="gothic">
        Gotisch
      </button>
      <button type="button" class="ig-style-pill px-2.5 py-1 rounded-lg text-[11px] font-bold bg-white/5 hover:bg-white/10 text-stone-300 hover:text-white border border-white/10 transition-all" data-style="strikethrough">
        Gestrichen
      </button>
    </div>
  </div>

  <!-- PHONE MOCKUP CONTAINER -->
  <div class="relative mx-auto w-full max-w-[320px] rounded-[2.5rem] bg-[#0c0d14] border-[5px] border-stone-800/90 shadow-2xl shadow-black/80 overflow-hidden text-white font-sans select-none">
    <!-- Top Dynamic Island & Status Bar -->
    <div class="pt-2 px-5 pb-1">
      <!-- Status bar icons row -->
      <div class="flex items-center justify-between text-[11px] text-stone-300 font-semibold">
        <span>09:41</span>
        <!-- Dynamic Island -->
        <div class="h-4 w-20 bg-black rounded-full flex items-center justify-end px-2 gap-1 border border-white/5">
          <div class="w-1.5 h-1.5 rounded-full bg-[#1e202e]"></div>
          <div class="w-1 h-1 rounded-full bg-emerald-500/80 animate-pulse"></div>
        </div>
        <div class="flex items-center gap-1 text-[10px]">
          <span>5G</span>
          <span>🔋</span>
        </div>
      </div>
    </div>

    <!-- Instagram Top Header Bar -->
    <div class="px-4 py-2 flex items-center justify-between border-b border-white/5">
      <div class="flex items-center gap-1.5">
        <span class="font-bold text-xs text-white tracking-tight flex items-center gap-1">
          dein_instagram_name
          <svg class="w-3.5 h-3.5 text-sky-400 inline" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
        </span>
        <span class="text-[10px] text-stone-400">⌄</span>
      </div>
      <div class="flex items-center gap-3 text-stone-300 text-sm">
        <span class="cursor-default hover:text-white transition-colors">➕</span>
        <span class="cursor-default hover:text-white transition-colors font-bold">☰</span>
      </div>
    </div>

    <!-- Profile Info Section -->
    <div class="p-4 space-y-3">
      <!-- Avatar & Follower Stats Row -->
      <div class="flex items-center justify-between gap-3">
        <!-- Avatar with Instagram Gradient Ring -->
        <div class="relative flex-shrink-0">
          <div class="w-16 h-16 rounded-full p-[2.5px] bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 shadow-md">
            <div class="w-full h-full rounded-full bg-[#161824] flex items-center justify-center text-white font-bold text-sm border-2 border-[#0c0d14]">
              <span>✨</span>
            </div>
          </div>
          <span class="absolute bottom-0 right-0 w-4 h-4 rounded-full bg-blue-500 text-white text-[10px] font-extrabold flex items-center justify-center border-2 border-[#0c0d14]">
            +
          </span>
        </div>

        <!-- 3 Stats Columns -->
        <div class="flex-1 grid grid-cols-3 gap-1 text-center">
          <div>
            <div class="font-extrabold text-xs sm:text-sm text-white">128</div>
            <div class="text-[10px] text-stone-400 leading-tight">Beiträge</div>
          </div>
          <div>
            <div class="font-extrabold text-xs sm:text-sm text-white">10,4K</div>
            <div class="text-[10px] text-stone-400 leading-tight">Follower</div>
          </div>
          <div>
            <div class="font-extrabold text-xs sm:text-sm text-white">542</div>
            <div class="text-[10px] text-stone-400 leading-tight">Gefolgt</div>
          </div>
        </div>
      </div>

      <!-- Live Name & Bio Text -->
      <div class="pt-1">
        <!-- Display Name (Live styled) -->
        <div id="ig-preview-name" class="font-bold text-xs text-white tracking-tight">
          Instagram Bio Vibes ✨
        </div>
        <!-- Category Badge -->
        <div class="text-[10px] text-stone-400 font-medium">
          Digital Creator · Social Media
        </div>
        <!-- Bio Content (Live updating from converter input) -->
        <div
          id="ig-preview-bio"
          class="text-xs text-stone-200 mt-1 leading-snug whitespace-pre-wrap break-words min-h-[32px] bg-white/[0.03] p-2 rounded-xl border border-white/5 font-sans"
        >
          Instagram Bio Vibes ✨
        </div>
        <!-- Link in Bio -->
        <div class="text-[11px] text-sky-400 font-medium mt-1.5 flex items-center gap-1 truncate">
          <span>🔗</span>
          <span class="hover:underline">schriftarten-generator.de/bio</span>
        </div>
      </div>

      <!-- Action Buttons Row (Cosmetic realism) -->
      <div class="grid grid-cols-7 gap-1.5 pt-1">
        <button
          type="button"
          tabindex="-1"
          class="col-span-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 text-stone-200 text-[11px] font-semibold text-center transition-colors pointer-events-none"
        >
          Bearbeiten
        </button>
        <button
          type="button"
          tabindex="-1"
          class="col-span-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 text-stone-200 text-[11px] font-semibold text-center transition-colors pointer-events-none"
        >
          Teilen
        </button>
        <button
          type="button"
          tabindex="-1"
          class="col-span-1 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 text-stone-200 text-[11px] font-semibold text-center transition-colors pointer-events-none flex items-center justify-center"
        >
          👤
        </button>
      </div>

      <!-- Story Highlights Row -->
      <div class="flex items-center gap-3 pt-2 overflow-x-hidden border-t border-white/5">
        <div class="flex flex-col items-center gap-1">
          <div class="w-10 h-10 rounded-full p-[1.5px] bg-white/20 flex items-center justify-center">
            <div class="w-full h-full rounded-full bg-[#181a24] flex items-center justify-center text-xs">
              ✨
            </div>
          </div>
          <span class="text-[9px] text-stone-400">Bio</span>
        </div>
        <div class="flex flex-col items-center gap-1">
          <div class="w-10 h-10 rounded-full p-[1.5px] bg-white/20 flex items-center justify-center">
            <div class="w-full h-full rounded-full bg-[#181a24] flex items-center justify-center text-xs">
              🎨
            </div>
          </div>
          <span class="text-[9px] text-stone-400">Fonts</span>
        </div>
        <div class="flex flex-col items-center gap-1">
          <div class="w-10 h-10 rounded-full p-[1.5px] bg-white/20 flex items-center justify-center">
            <div class="w-full h-full rounded-full bg-[#181a24] flex items-center justify-center text-xs">
              🌴
            </div>
          </div>
          <span class="text-[9px] text-stone-400">Vibes</span>
        </div>
        <div class="flex flex-col items-center gap-1">
          <div class="w-10 h-10 rounded-full border border-dashed border-stone-600 flex items-center justify-center text-stone-400 text-xs">
            +
          </div>
          <span class="text-[9px] text-stone-400">Neu</span>
        </div>
      </div>
    </div>

    <!-- Bottom Home Indicator Bar -->
    <div class="py-2 flex justify-center bg-black/40">
      <div class="w-24 h-1 bg-stone-500/60 rounded-full"></div>
    </div>
  </div>

  <!-- Mandatory Compliance Disclaimer Caption -->
  <p class="text-center text-[11px] text-stone-400 mt-3 flex items-center justify-center gap-1.5">
    <span>ℹ️</span>
    <span>Beispielwerte zur Veranschaulichung</span>
  </p>
</div>

<script>
  import {
    toBoldSans,
    toItalicSerif,
    toScript,
    toSmallCaps,
    toCircledWhite,
    toBoldFraktur,
    addCombining,
  } from '../data/themed-variation-builder';

  function initInstagramLivePreview() {
    const inputBox = document.getElementById('converter-input-box') as HTMLTextAreaElement;
    const previewBio = document.getElementById('ig-preview-bio');
    const previewName = document.getElementById('ig-preview-name');
    const stylePills = document.querySelectorAll('.ig-style-pill');
    const activeLabel = document.getElementById('ig-active-style-label');

    if (!previewBio || !previewName) return;

    let activeStyle = 'bold-sans';

    const transformers: Record<string, (text: string) => string> = {
      'bold-sans': (t) => toBoldSans(t),
      'italic': (t) => toItalicSerif(t),
      'script': (t) => toScript(t),
      'small-caps': (t) => toSmallCaps(t),
      'bubble': (t) => toCircledWhite(t),
      'gothic': (t) => toBoldFraktur(t),
      'strikethrough': (t) => addCombining(t, '\u0336'),
    };

    function updatePreview() {
      const rawText = inputBox ? inputBox.value.trim() || 'Instagram Bio Vibes ✨' : 'Instagram Bio Vibes ✨';
      const transformFn = transformers[activeStyle] || transformers['bold-sans'];
      const transformedText = transformFn(rawText);

      previewBio.textContent = transformedText;
      previewName.textContent = transformedText;
    }

    // Connect to input box typing
    if (inputBox) {
      inputBox.addEventListener('input', updatePreview);
    }

    // Connect to preset pills clicks
    const presetPills = document.querySelectorAll('.preset-pill');
    presetPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        setTimeout(updatePreview, 50);
      });
    });

    // Quick actions (upper, lower, clear)
    ['btn-uppercase', 'btn-lowercase', 'btn-clear-text'].forEach((id) => {
      const btn = document.getElementById(id);
      if (btn) {
        btn.addEventListener('click', () => {
          setTimeout(updatePreview, 50);
        });
      }
    });

    // Style switcher pills
    stylePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        stylePills.forEach((p) => {
          p.classList.remove('active', 'bg-amber-500', 'text-black', 'shadow-sm');
          p.classList.add('bg-white/5', 'text-stone-300', 'border', 'border-white/10');
        });

        pill.classList.remove('bg-white/5', 'text-stone-300', 'border', 'border-white/10');
        pill.classList.add('active', 'bg-amber-500', 'text-black', 'shadow-sm');

        const styleKey = pill.getAttribute('data-style') || 'bold-sans';
        activeStyle = styleKey;
        if (activeLabel) {
          activeLabel.textContent = pill.textContent?.trim().toLowerCase() || activeStyle;
        }

        updatePreview();
      });
    });

    // Initial render
    updatePreview();
  }

  // Initialize on page load and view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInstagramLivePreview);
  } else {
    initInstagramLivePreview();
  }
</script>
