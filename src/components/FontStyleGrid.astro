---
import { NAVIGATION_DATA } from '../data/navigation';

interface Props {
  title?: string;
  titleIcon?: string;
  currentSlug?: string;
  isAmberTitle?: boolean;
}

const {
  title = 'Weitere Schriftstile',
  titleIcon = '🎨',
  currentSlug,
  isAmberTitle = false,
} = Astro.props;

const stylesToShow = currentSlug
  ? NAVIGATION_DATA.fontStyles.items.filter((item) => !item.href.includes(currentSlug))
  : NAVIGATION_DATA.fontStyles.items;
---

<div class="bg-[#141412] border border-white/10 rounded-3xl p-6">
  <div class="flex items-center justify-between mb-4">
    <h3 class={`text-sm font-bold uppercase tracking-wider flex items-center gap-1.5 ${isAmberTitle ? 'text-amber-400' : 'text-stone-300'}`}>
      {titleIcon && <span>{titleIcon}</span>}
      <span>{title}</span>
    </h3>
    <span class="text-[11px] font-semibold text-stone-500 font-mono">
      {stylesToShow.length} Stile
    </span>
  </div>
  <div class="flex flex-wrap gap-1.5">
    {stylesToShow.map((styleItem) => (
      <a
        href={styleItem.href}
        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-white/5 hover:bg-amber-500/20 text-stone-300 hover:text-amber-400 text-xs font-medium border border-white/5 hover:border-amber-500/30 transition-all"
      >
        <span class="text-amber-400 font-mono font-bold text-[11px]">{styleItem.icon}</span>
        <span>{styleItem.title}</span>
      </a>
    ))}
  </div>
</div>
