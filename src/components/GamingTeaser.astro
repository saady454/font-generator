---
import { GAMES_DATA } from '../data/game-metadata';

const games = Object.values(GAMES_DATA);
---

<section class="py-20 bg-[#0a0a08] border-t border-white/5">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="text-xs font-bold uppercase tracking-wider text-amber-500 mb-2">
        Gaming & Nicknames
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
        Coole Schriftarten für Gaming Nicknames & Clantags
      </h2>
      <p class="mt-2 text-sm text-stone-400">
        Hebe dich in der Lobby und im Kill-Feed ab — spezielle Schriftstile für Fortnite, Minecraft, Valorant, Roblox & mehr.
      </p>
    </div>

    <!-- Games Grid: Fortnite & Minecraft leading first -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {games.map((g) => (
        <div class="bg-[#141412] border border-white/10 hover:border-amber-500/40 rounded-2xl p-6 transition-all hover:-translate-y-1 group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">
                {g.name}
              </h3>
              <span class="px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-400 text-[11px] font-bold">
                {g.genre}
              </span>
            </div>

            <p class="text-xs text-stone-400 leading-relaxed mb-4">
              {g.description}
            </p>

            <div class="space-y-1.5 mb-4">
              <div class="text-[11px] font-bold uppercase tracking-wider text-stone-500 font-mono">
                Beispiel Nicknames:
              </div>
              {g.exampleNicknames.slice(0, 3).map((nick) => (
                <div class="px-3 py-1.5 rounded-xl bg-black/50 border border-white/5 text-xs text-stone-200 font-mono break-all select-all flex items-center justify-between">
                  <span>{nick}</span>
                </div>
              ))}
            </div>
          </div>

          <a
            href={g.slug}
            class="mt-4 pt-3 flex items-center justify-between text-xs text-stone-400 group-hover:text-amber-400 font-bold border-t border-white/5"
          >
            <span>Nickname-Generator für {g.name}</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
